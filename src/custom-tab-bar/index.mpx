  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.tab-icon--user::after {
  left: 9rpx;
  top: 29rpx;
  width: 32rpx;
  height: 17rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 0 0;
}

.tab-item--primary {
  height: 118rpx;
  margin-top: -44rpx;
}

.tab-item--primary .tab-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin-top: 0;
  border-radius: 32rpx;
  background: #ff2442;
  color: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(255, 36, 66, 0.32);
}

.tab-item--primary .tab-text {
  margin-top: 10rpx;
  color: #ff2442;
