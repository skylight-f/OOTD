  color: #ffffff;
  font-size: 66rpx;
  line-height: 1;
  font-weight: 600;
}

.tab-badge {
  position: absolute;
  top: 0;
  right: 32rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #ff2442;
  color: #ffffff;
  font-size: 18rpx;
