  position: relative;
  width: 48rpx;
  height: 48rpx;
  margin-top: 6rpx;
  box-sizing: border-box;
}

.tab-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 500;
}

.tab-item--active .tab-text {
  font-weight: 700;
}

.tab-icon--home::before,
.tab-icon--closet::before,
.tab-icon--outfit::before,
.tab-icon--user::before,
.tab-icon--home::after,
.tab-icon--closet::after,
.tab-icon--outfit::after,
.tab-icon--user::after {
  content: '';
  position: absolute;
  box-sizing: border-box;
}

.tab-icon--home::before {
  left: 8rpx;
  top: 18rpx;
  width: 32rpx;
  height: 24rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 8rpx 8rpx;
}

.tab-icon--home::after {
  left: 9rpx;
  top: 6rpx;
  width: 30rpx;
  height: 30rpx;
  border-top: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.tab-icon--closet::before {
  left: 8rpx;
  top: 7rpx;
  width: 32rpx;
  height: 38rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
}

.tab-icon--closet::after {
  left: 23rpx;
  top: 11rpx;
  width: 4rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.tab-icon--outfit::before {
  left: 9rpx;
  top: 7rpx;
  width: 30rpx;
  height: 38rpx;
  border: 4rpx solid currentColor;
  border-radius: 18rpx 18rpx 8rpx 8rpx;
}

.tab-icon--outfit::after {
  left: 20rpx;
  top: 7rpx;
  width: 8rpx;
  height: 14rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: currentColor;
}

.tab-icon--user::before {
  left: 16rpx;
