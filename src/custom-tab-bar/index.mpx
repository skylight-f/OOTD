<template>
  <view class="tab-bar">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'tab-item--active' : ''}} {{item.primary ? 'tab-item--primary' : ''}}"
      data-index="{{index}}"
      data-path="{{item.pagePath}}"
      bindtap="switchTab"
    >
      <view class="tab-icon tab-icon--{{item.icon}}">
        <text wx:if="{{item.primary}}" class="plus-icon">+</text>
      </view>
      <text class="tab-text">{{item.text}}</text>
      <text wx:if="{{item.badge}}" class="tab-badge">{{item.badge}}</text>
    </view>
  </view>
</template>

<script lang="ts">
import { createComponent } from '@mpxjs/core'


type TabEvent = {
  currentTarget: {
    dataset: {
      index: number
      path: string
    }
  }
}

createComponent({
  data: {
    selected: 0,
    list: [
      { pagePath: 'pages/homePage/index', text: '首页', icon: 'home' },
      { pagePath: 'pages/closetPage/index', text: '衣橱', icon: 'closet' },
      { pagePath: 'pages/addClothesPage/index', text: '添加', icon: 'add', primary: true },
      { pagePath: 'pages/outfitPage/index', text: '搭配', icon: 'outfit' },
      { pagePath: 'pages/myPage/index', text: '我的', icon: 'user' }
    ]
  },
  methods: {
    switchTab(event: TabEvent) {
      const { index, path } = event.currentTarget.dataset
      if (Number(index) === this.data.selected) return

      wx.switchTab({
        url: `/${path}`
      })
    }
  }
})
</script>

<style lang="less">
.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  display: flex;
  align-items: flex-start;
  height: 118rpx;
  padding: 10rpx 18rpx env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 28rpx rgba(0, 0, 0, 0.08);
  box-sizing: content-box;
}

.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
  height: 108rpx;
  color: #8a8a8a;
}

