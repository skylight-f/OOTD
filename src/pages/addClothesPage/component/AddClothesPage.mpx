  width: 400rpx;
  height: 400rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-placeholder-text {
  font-size: 26rpx;
  color: #bbbbbb;
}

.preview-actions {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 20rpx;
}

.preview-btn {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: #ffe8ec;
}

.preview-btn-text {
  font-size: 24rpx;
  color: #ff2442;
  font-weight: 600;
}

/* 表单项 */
.form-item {
  margin-top: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
