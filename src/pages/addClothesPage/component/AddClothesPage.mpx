  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: #ff2442;
  box-shadow: 0 16rpx 34rpx rgba(255, 36, 66, 0.28);
}

