  font-size: 24rpx;
  color: #666666;
}

.scene-tag--active .scene-tag-text {
  color: #ffffff;
  font-weight: 600;
}

/* 操作按钮 */
.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
  padding: 0 28rpx;
}

.form-actions-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 999;
}

.btn-cancel {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 8rpx;
  background: #f2f2f2;
}

.btn-cancel-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #666666;
}

.btn-save {
  flex: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 8rpx;
  background: #ff2442;
  box-shadow: 0 12rpx 28rpx rgba(255, 36, 66, 0.28);
}

.btn-save-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

/* ---- 吊牌信息弹窗 ---- */

.tag-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tag-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.tag-modal-panel {
  position: relative;
  width: 85%;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  animation: modalIn 0.25s ease-out;
}

@keyframes modalIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
