  line-height: 1.5;
  color: #818181;
}

.tips-card {
  margin-top: 2rpx;
  padding: 28rpx;
  border-radius: 8rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #222222;
}

.tips-list {
  margin-top: 18rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

