  line-height: 1.55;
  color: #666666;
}

/* ---- 表单区域样式 ---- */

.form-section {
  margin-top: 18rpx;
  padding-bottom: 260rpx;
}

.form-card {
  padding: 28rpx;
  border-radius: 8rpx;
  margin-top: 18rpx;
}

/* 图片预览 */
.preview-wrap {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
}

.preview-image {
  width: 400rpx;
  height: 400rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
}

