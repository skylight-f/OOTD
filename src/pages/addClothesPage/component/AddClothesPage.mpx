<template>
  <view class="page add-clothes-page">
    <!-- 顶部相机区域 -->
    <view class="scan-card" bindtap="onTapCamera">
      <view class="camera-mark">
        <text class="camera-plus">+</text>
      </view>
      <text class="scan-title">添加衣服</text>
      <text class="scan-desc">拍照或从相册选择衣服，整理进你的数字衣橱。</text>
    </view>

    <!-- 入口卡片（非表单模式时显示） -->
    <view class="entry-grid" wx:if="{{!showForm}}">
      <view
        wx:for="{{entries}}"
        wx:key="title"
        class="entry-card"
        bindtap="onTapEntry"
        data-index="{{index}}"
      >
        <text class="entry-icon">{{item.icon}}</text>
        <text class="entry-title">{{item.title}}</text>
        <text class="entry-desc">{{item.desc}}</text>
      </view>
    </view>

    <!-- 吊牌信息弹窗 -->
    <view class="tag-modal" wx:if="{{showTagModal}}">
      <view class="tag-modal-mask" bindtap="onCloseTagModal"></view>
      <view class="tag-modal-panel">
        <view class="tag-modal-header">
          <text class="tag-modal-title">📋 吊牌信息</text>
          <text class="tag-modal-close" bindtap="onCloseTagModal">✕</text>
        </view>
        <view class="tag-modal-body">
          <view class="tag-field">
            <text class="tag-label">品牌</text>
            <input class="tag-input" placeholder="如：UNIQLO" value="{{tagForm.brand}}" bindinput="onTagBrand" />
          </view>
          <view class="tag-field">
            <text class="tag-label">尺码</text>
            <input class="tag-input" placeholder="如：M / 170/88A" value="{{tagForm.size}}" bindinput="onTagSize" />
          </view>
          <view class="tag-field">
            <text class="tag-label">材质</text>
            <input class="tag-input" placeholder="如：100%棉" value="{{tagForm.material}}" bindinput="onTagMaterial" />
          </view>
          <view class="tag-field">
            <text class="tag-label">价格</text>
            <input class="tag-input" type="digit" placeholder="如：299" value="{{tagForm.price}}" bindinput="onTagPrice" />
          </view>
        </view>
        <view class="tag-modal-footer">
          <view class="tag-btn tag-btn-cancel" bindtap="onCloseTagModal">取消</view>
          <view class="tag-btn tag-btn-confirm" bindtap="onConfirmTag">填入表单</view>
        </view>
      </view>
    </view>

    <!-- 表单编辑模式 -->
    <view class="form-section" wx:if="{{showForm}}">
      <!-- 图片预览 -->
      <view class="form-card">
        <text class="section-title">衣物预览</text>
        <view class="preview-wrap">
          <image
            wx:if="{{selectedImage}}"
            class="preview-image"
            src="{{selectedImage}}"
            mode="aspectFit"
          />
          <view wx:else class="preview-placeholder">
            <text class="preview-placeholder-text">未选择图片</text>
          </view>
        </view>
        <view class="preview-actions">
          <view class="preview-btn" bindtap="onTapCamera">
            <text class="preview-btn-text">重新拍照</text>
          </view>
          <view class="preview-btn" bindtap="onTapAlbum">
            <text class="preview-btn-text">从相册选择</text>
          </view>
        </view>
      </view>

      <!-- 基本信息输入 -->
      <view class="form-card">
        <text class="section-title">基本信息</text>

        <view class="form-item">
          <text class="form-label">名称</text>
          <input
            class="form-input"
            placeholder="如：燕麦针织开衫"
            value="{{formData.name}}"
            bindinput="onInputName"
          />
        </view>

        <view class="form-item">
          <text class="form-label">颜色</text>
          <input
            class="form-input"
            placeholder="如：燕麦白"
            value="{{formData.color}}"
            bindinput="onInputColor"
          />
        </view>

        <view class="form-item">
          <text class="form-label">材质</text>
          <input
            class="form-input"
            placeholder="如：羊毛混纺"
            value="{{formData.material}}"
            bindinput="onInputMaterial"
          />
        </view>

        <view class="form-item">
          <text class="form-label">品牌</text>
          <input
            class="form-input"
            placeholder="可选"
            value="{{formData.brand}}"
            bindinput="onInputBrand"
          />
        </view>

        <view class="form-item">
          <text class="form-label">尺码</text>
          <input
            class="form-input"
            placeholder="如：M / 170/88A"
            value="{{formData.size}}"
            bindinput="onInputSize"
          />
        </view>

        <view class="form-item">
          <text class="form-label">价格</text>
          <input
            class="form-input"
            type="digit"
            placeholder="如：299"
            value="{{formData.price}}"
            bindinput="onInputPrice"
          />
        </view>
      </view>

      <!-- 分类选择 -->
      <view class="form-card">
        <text class="section-title">分类信息</text>

        <view class="form-item">
          <text class="form-label">类别</text>
          <picker
            class="form-picker"
            mode="selector"
            range="{{categoryOptions}}"
            value="{{categoryIndex}}"
            bindchange="onCategoryChange"
          >
            <view class="picker-display">
              <text class="picker-text">{{categoryOptions[categoryIndex]}}</text>
              <text class="picker-arrow">▸</text>
            </view>
          </picker>
        </view>

        <view class="form-item">
          <text class="form-label">季节</text>
          <picker
            class="form-picker"
            mode="selector"
            range="{{seasonOptions}}"
            value="{{seasonIndex}}"
            bindchange="onSeasonChange"
          >
            <view class="picker-display">
              <text class="picker-text">{{seasonOptions[seasonIndex]}}</text>
              <text class="picker-arrow">▸</text>
            </view>
          </picker>
        </view>

        <view class="form-item">
          <text class="form-label">适合场景</text>
          <view class="scene-tags">
            <view
              wx:for="{{sceneOptions}}"
              wx:key="*this"
              class="scene-tag {{selectedScenes.indexOf(item) > -1 ? 'scene-tag--active' : ''}}"
              bindtap="onToggleScene"
              data-scene="{{item}}"
            >
              <text class="scene-tag-text">{{item}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 录入建议（非表单模式时显示） -->
    <view class="tips-card" wx:if="{{!showForm}}">
      <text class="section-title">录入建议</text>
      <view class="tips-list">
        <view wx:for="{{tips}}" wx:key="*this" class="tip-item">
          <text class="tip-dot"></text>
          <text class="tip-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 底部固定操作按钮（表单模式时显示） -->
    <view class="form-actions-fixed" wx:if="{{showForm}}">
      <view class="btn-cancel" bindtap="onCancel">
        <text class="btn-cancel-text">取消</text>
      </view>
      <view class="btn-save" bindtap="onSave">
        <text class="btn-save-text">保存</text>
      </view>
    </view>
  </view>
</template>

<script lang="ts">
import { createComponent } from '@mpxjs/core'
import { addClothing, saveImageToTemp, inferTone } from '@/utils/storage'
import type { ClothingInput } from '@/utils/storage'

createComponent({
  data: {
    // 入口卡片数据
    entries: [
      { icon: '拍', title: '拍照录入', desc: '适合刚买的新衣服', action: 'camera' },
      { icon: '册', title: '相册选择', desc: '批量整理历史照片', action: 'album' },
      { icon: '码', title: '吊牌信息', desc: '记录尺码和材质', action: 'tag' },
      { icon: '分', title: '快速分类', desc: '按季节和场景归档', action: 'classify' }
    ],
    tips: ['尽量使用自然光拍摄', '保留完整轮廓，减少背景干扰', '录入颜色、材质和适合场景，推荐会更准'],

    // 表单模式控制
    showForm: false,
    selectedImage: '',

    // 吊牌信息弹窗
    showTagModal: false,
    tagForm: {
      brand: '',
      size: '',
      material: '',
      price: ''
    },

    // 表单数据
    formData: {
      name: '',
      color: '',
      material: '',
      brand: '',
      size: '',
      price: ''
    },

    // Picker 选项
    categoryOptions: ['上装', '下装', '外套', '鞋履', '配饰', '包袋'],
    categoryIndex: 0,
    seasonOptions: ['春夏', '秋冬', '四季'],
    seasonIndex: 0,
    sceneOptions: ['通勤', '周末', '约会', '运动', '居家', '旅行', '正式'],
    selectedScenes: [] as string[]
  },

  methods: {
    /** 点击相机区域或"拍照录入"卡片 */
    onTapCamera() {
      wx.chooseMedia({
        count: 1,
        mediaType: ['image'],
        sourceType: ['camera'],
        success: (res) => {
          if (res.tempFiles && res.tempFiles.length > 0) {
            this.handleImageSelected(res.tempFiles[0].tempFilePath)
          }
        },
        fail: () => {
          // 用户取消，不做处理
        }
      })
    },

    /** 点击"相册选择"卡片 */
    onTapAlbum() {
      wx.chooseMedia({
        count: 1,
        mediaType: ['image'],
        sourceType: ['album'],
        success: (res) => {
          if (res.tempFiles && res.tempFiles.length > 0) {
            this.handleImageSelected(res.tempFiles[0].tempFilePath)
          }
        },
        fail: () => {
          // 用户取消，不做处理
        }
      })
    },

    /** 统一处理入口卡片点击 */
    onTapEntry(e: any) {
      const index = e.currentTarget.dataset.index
      const entry = this.entries[index]

      switch (entry.action) {
        case 'camera':
          this.onTapCamera()
          break
        case 'album':
          this.onTapAlbum()
          break
        case 'tag':
          this.setData({ showTagModal: true })
          break
        case 'classify':
          wx.showToast({ title: '功能开发中', icon: 'none', duration: 1500 })
          break
        default:
          break
      }
    },

    /** 吊牌输入绑定 */
    onTagBrand(e: any) {
      this.setData({ 'tagForm.brand': e.detail.value })
    },
    onTagSize(e: any) {
      this.setData({ 'tagForm.size': e.detail.value })
    },
    onTagMaterial(e: any) {
      this.setData({ 'tagForm.material': e.detail.value })
    },
    onTagPrice(e: any) {
      this.setData({ 'tagForm.price': e.detail.value })
    },

    /** 关闭吊牌弹窗 */
    onCloseTagModal() {
      this.setData({ showTagModal: false })
    },

    /** 确认吊牌信息，填入表单 */
    onConfirmTag() {
      const { tagForm, formData } = this.data
      this.setData({
        showTagModal: false,
        'formData.brand': tagForm.brand || formData.brand,
        'formData.material': tagForm.material || formData.material,
        'formData.size': tagForm.size,
        'formData.price': tagForm.price
      })
      wx.showToast({ title: '已填入表单', icon: 'success', duration: 1200 })
    },

    /** 图片选择后进入表单模式 */
    handleImageSelected(tempFilePath: string) {
      this.setData({
        showForm: true,
        selectedImage: tempFilePath
      })
    },

    /** 表单输入绑定 */
    onInputName(e: any) {
      this.setData({ 'formData.name': e.detail.value })
    },

    onInputColor(e: any) {
      this.setData({ 'formData.color': e.detail.value })
    },

    onInputMaterial(e: any) {
      this.setData({ 'formData.material': e.detail.value })
    },

    onInputBrand(e: any) {
      this.setData({ 'formData.brand': e.detail.value })
    },

    onInputSize(e: any) {
      this.setData({ 'formData.size': e.detail.value })
    },

    onInputPrice(e: any) {
      this.setData({ 'formData.price': e.detail.value })
    },

    /** 类别选择器变化 */
    onCategoryChange(e: any) {
      this.setData({ categoryIndex: Number(e.detail.value) })
    },

    /** 季节选择器变化 */
    onSeasonChange(e: any) {
      this.setData({ seasonIndex: Number(e.detail.value) })
    },

    /** 场景多选切换 */
    onToggleScene(e: any) {
      const scene = e.currentTarget.dataset.scene
      const current: string[] = [...this.selectedScenes]
      const idx = current.indexOf(scene)

      if (idx > -1) {
        current.splice(idx, 1)
      } else {
        current.push(scene)
      }

      this.setData({ selectedScenes: current })
    },

    /** 取消编辑，重置回初始状态 */
    onCancel() {
      this.setData({
        showForm: false,
        selectedImage: '',
        formData: {
          name: '',
          color: '',
          material: '',
          brand: '',
          size: '',
          price: ''
        },
        categoryIndex: 0,
        seasonIndex: 0,
        selectedScenes: []
      })
    },

    /** 保存衣物 */
    onSave() {
      const { formData, categoryIndex, categoryOptions, seasonIndex, seasonOptions, selectedScenes, selectedImage } = this.data

      // 验证必填项
      if (!formData.name.trim()) {
        wx.showToast({ title: '请输入衣物名称', icon: 'none', duration: 1500 })
        return
      }

      wx.showLoading({ title: '保存中...' })

      const category = categoryOptions[categoryIndex]
      const season = seasonOptions[seasonIndex]
      const scene = selectedScenes.length > 0 ? selectedScenes.join(' / ') : '日常'
      const tone = inferTone(formData.color)

      // 保存图片到持久目录，然后保存衣物数据
      const doSaveClothing = (imagePath: string) => {
        try {
          const input: ClothingInput = {
            name: formData.name.trim(),
            category: category,
            color: formData.color.trim() || '未填写',
            material: formData.material.trim() || '未填写',
            scene: scene,
            season: season,
            imagePath: imagePath,
            tone: tone,
            brand: formData.brand.trim(),
            size: formData.size.trim(),
            price: formData.price.trim()
          }

          addClothing(input)

          wx.hideLoading()
          wx.showToast({ title: '添加成功', icon: 'success', duration: 1500 })

          // 重置表单
          setTimeout(() => {
            this.onCancel()
          }, 1500)
        } catch (err) {
          wx.hideLoading()
          wx.showToast({ title: '保存失败，请重试', icon: 'none', duration: 2000 })
        }
      }

      if (selectedImage) {
        saveImageToTemp(selectedImage)
          .then((savedPath) => {
            doSaveClothing(savedPath)
          })
          .catch(() => {
            // 图片保存失败时，使用临时路径继续
            doSaveClothing(selectedImage)
          })
      } else {
        doSaveClothing('')
      }
    }
  }
})
</script>

<style lang="less">
