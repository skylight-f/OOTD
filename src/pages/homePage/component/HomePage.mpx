<template>
  <view class="page home-page home-page--{{transitionDirection}}" bindtouchstart="handleTabTouchStart" bindtouchend="handleTabTouchEnd">
    <view class="custom-nav" style="padding-top: {{statusBarHeight}}px; padding-right: {{navRightPad}}px;">
      <view class="nav-content">
        <view class="nav-main">
          <text class="nav-title">OOTD</text>
          <view class="nav-weather">
            <text class="nav-weather-dot"></text>
            <text>{{weather.city}} {{weather.temperature}}°</text>
          </view>
        </view>

        <view class="nav-actions">
          <text class="nav-icon nav-icon--search" bindtap="onTapNavSearch"></text>
          <text class="nav-icon nav-icon--calendar" bindtap="onTapNavCalendar"></text>
        </view>
      </view>

      <view class="home-tabs">
        <text
          wx:for="{{homeTabs}}"
          wx:key="key"
          class="home-tab {{activeTab === item.key ? 'home-tab--active' : ''}}"
          data-tab="{{item.key}}"
          bindtap="switchHomeTab"
        >{{item.label}}</text>
      </view>
    </view>

    <view wx:if="{{activeTab === 'recommend'}}" class="recommend-panel">
      <view class="feed-tools">
        <view class="city-pill">
          <text class="city-dot"></text>
          <text>{{weather.city}}</text>
        </view>
        <text class="search-icon"></text>
      </view>

      <view wx:if="{{waterfallColumns[0].length === 0 && waterfallColumns[1].length === 0}}" class="waterfall-empty">
        <view class="empty-icon">👗</view>
        <text class="empty-title">还没有穿搭记录</text>
        <text class="empty-desc">添加衣物后创建你的第一套搭配吧</text>
      </view>

      <view wx:else class="waterfall">
        <view wx:for="{{waterfallColumns}}" wx:for-item="column" wx:for-index="columnIndex" wx:key="columnIndex" class="waterfall-column">
          <view wx:for="{{column}}" wx:for-item="card" wx:key="id" class="masonry-card" data-id="{{card.id}}" data-type="{{card.type}}" bindtap="goWaterfallCard">
            <view class="card-cover card-cover--{{card.tone}} card-cover--{{card.size}}">
              <image wx:if="{{card.imagePath}}" class="card-image" src="{{card.imagePath}}" mode="aspectFill" />
              <view class="cover-shine"></view>
              <text class="cover-label">{{card.label}}</text>
              <text wx:if="{{card.isVideo}}" class="video-mark">▶</text>
            </view>
            <view class="card-body">
              <text class="card-title">{{card.title}}</text>
              <view class="card-meta">
                <text class="record-scene">{{card.scene}}</text>
                <text class="record-count">{{card.record}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="weather-panel panel-motion">
      <view class="hero-card" style="background: {{weatherGradient}}">
        <view class="hero-main">
          <text class="eyebrow">天气驱动推荐</text>
          <text class="city">{{weather.city}}</text>
          <text class="summary">{{weather.summary}}</text>
          <view class="temperature-row">
            <text class="temperature">{{weather.temperature}}°</text>
            <text class="range">{{weather.low}}° / {{weather.high}}°</text>
          </view>
          <view class="tag-row">
            <text wx:for="{{weather.tags}}" wx:key="*this" class="tag">{{item}}</text>
          </view>
        </view>

        <view class="hero-panel">
          <text class="panel-label">今日主张</text>
          <text class="panel-title">{{recommendation.title}}</text>
          <text class="panel-desc">{{recommendation.description}}</text>
        </view>
      </view>

      <!-- 空衣橱引导 -->
      <view wx:if="{{wardrobeEmpty}}" class="section-card wardrobe-guide">
        <view class="guide-icon">👗</view>
        <text class="guide-title">衣橱还是空的</text>
        <text class="guide-desc">先添加几件衣物，才能获得更精准的穿搭推荐哦</text>
        <view class="guide-btn" bindtap="goAddClothes">
          <text class="guide-btn-text">去添加衣物</text>
        </view>
      </view>

      <view class="section-card">
        <view class="section-head">
          <text class="section-title">推荐搭配</text>
          <text class="section-subtitle">适合 {{recommendation.scene}}</text>
        </view>

        <view wx:if="{{wardrobeMatchCount > 0}}" class="wardrobe-hint">
          <text class="wardrobe-hint-text">{{wardrobeMatchCount}} 件来自你的衣橱</text>
        </view>

        <view class="formula-list">
          <view wx:for="{{recommendation.items}}" wx:key="name" class="formula-item" data-id="{{item.clothingId}}" bindtap="{{item.fromWardrobe ? 'goClothingDetail' : ''}}">
            <view class="formula-badge {{item.fromWardrobe ? 'formula-badge--matched' : ''}}">{{item.fromWardrobe ? '✓' : index + 1}}</view>
            <view class="formula-body">
              <view class="formula-name-row">
                <text class="formula-name">{{item.name}}</text>
                <text wx:if="{{item.fromWardrobe}}" class="wardrobe-badge">衣橱</text>
              </view>
              <text class="formula-meta">{{item.role}} · {{item.reason}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="section-card tips-card">
        <view class="section-head">
          <text class="section-title">推荐理由</text>
          <text class="section-subtitle">兼顾天气和通勤舒适度</text>
        </view>

        <view class="reason-list">
          <view wx:for="{{reasons}}" wx:key="title" class="reason-item">
            <text class="reason-title">{{item.title}}</text>
            <text class="reason-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <view class="section-card agenda-card">
        <text class="section-title">今日穿搭提醒</text>
        <view class="agenda-grid">
          <view wx:for="{{agendas}}" wx:key="title" class="agenda-item">
            <text class="agenda-title">{{item.title}}</text>
            <text class="agenda-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script lang="ts">
import { createComponent } from '@mpxjs/core'
import { getWeatherInfo, type WeatherInfo } from '@/utils/weather'
import { getCurrentLocation } from '@/utils/location'
import { fetchAllClothes, fetchAllOutfits } from '@/api/request'
import type { ClothingItem, OutfitItem } from '@/utils/storage'

type HomeTabEvent = {
  currentTarget: {
    dataset: {
      tab: string
    }
  }
}

type TouchPoint = {
  clientX: number
  clientY: number
}

type HomeTouchEvent = {
  touches?: TouchPoint[]
  changedTouches?: TouchPoint[]
}


const homeTabKeys = ['weather', 'recommend']

/** 类别角色映射（推荐角色 → 衣橱类别） */
function roleToCategory(role: string): string {
  const map: Record<string, string> = {
    '外套': '外套', '内搭': '上装', '上装': '上装',
    '下装': '下装', '鞋履': '鞋履', '配饰': '配饰'
  }
  return map[role] || role
}

/** 衣橱匹配推荐单品 */
function matchWardrobe(
  items: Array<{ name: string; role: string; reason: string }>,
  clothes: ClothingItem[]
): Array<{ name: string; role: string; reason: string; fromWardrobe: boolean; clothingId?: string }> {
  return items.map((item) => {
    const category = roleToCategory(item.role)
    const match = clothes.find((c) => c.category === category)
    if (match) {
      return {
        name: match.name,
        role: item.role,
        reason: item.reason,
        fromWardrobe: true,
        clothingId: match.id
      }
    }
    return { ...item, fromWardrobe: false }
  })
}

/** 根据温度生成穿搭建议数据 */
function buildRecommendation(weather: WeatherInfo) {
  const { temperature, low, high, condition } = weather
  const tempRange = high - low

  // 根据温度选择穿搭方向
  if (temperature <= 10) {
    return {
      title: '暖层叠穿方案',
      description: '气温较低，建议以内搭+中层保暖+防风外套的三层结构出门，兼顾保暖和行动自由度。',
      scene: '寒冷天气通勤',
      items: [
        { name: '高领毛衣', role: '内搭', reason: '贴身保暖，减少冷风灌入' },
        { name: '羊毛大衣', role: '外套', reason: '挡风效果优于普通棉服' },
        { name: '深色直筒裤', role: '下装', reason: '厚实面料更适合低温' },
        { name: '皮靴', role: '鞋履', reason: '保暖且防滑' }
      ]
    }
  } else if (temperature <= 18) {
    return {
      title: '轻保暖通勤风',
      description: '温度适中偏凉，一件轻薄外套搭配基础内搭即可，注重层次感避免单调。',
      scene: '办公室 + 下班外出',
      items: [
        { name: '薄款针织衫', role: '内搭', reason: '办公室温度下不会闷热' },
        { name: '休闲西装', role: '外套', reason: '兼顾通勤感和适度保暖' },
        { name: '深色休闲裤', role: '下装', reason: '百搭且适合多种场合' },
        { name: '帆布鞋', role: '鞋履', reason: '轻便舒适适合日常' }
      ]
    }
  } else if (temperature <= 25) {
    return {
      title: '轻层次通勤风',
      description: `用轻薄外套和柔和色系拉开层次，兼顾办公室冷气和${condition.includes('雨') ? '外出防雨' : '下班降温'}。`,
      scene: '办公室 + 下班外出',
      items: [
        { name: '奶油色风衣', role: '外套', reason: tempRange >= 6 ? '早晚温差大时更从容' : '轻薄有型' },
        { name: '雾蓝衬衫', role: '内搭', reason: '低饱和蓝色更显干净' },
        { name: '深灰直筒裤', role: '下装', reason: '稳住通勤感并显利落' },
        { name: '黑色乐福鞋', role: '鞋履', reason: '应对通勤步行和正式场景' }
      ]
    }
  } else {
    return {
      title: '清爽极简风',
      description: '气温较高，选择透气面料和浅色系，减少层次保持清凉感。',
      scene: '日常通勤',
      items: [
        { name: '浅色短袖T恤', role: '上装', reason: '透气面料应对高温' },
        { name: '棉麻短裤/裙', role: '下装', reason: '宽松版型更凉爽' },
        { name: '凉鞋或帆布鞋', role: '鞋履', reason: '轻便透气' },
        { name: '遮阳帽', role: '配饰', reason: condition.includes('晴') ? '紫外线较强需注意防晒' : '搭配加分项' }
      ]
    }
  }
}

/** 根据天气生成推荐理由 */
function buildReasons(weather: WeatherInfo) {
  const { condition, temperature, humidity, feelsLike } = weather
  const reasons: Array<{ title: string; desc: string }> = []

  if (condition.includes('雨')) {
    reasons.push({ title: '防雨', desc: `${condition.includes('大') ? '今天雨势较大' : '今天有雨'}，建议携带雨具并选择防水面料。` })
  }
  if (temperature > 28) {
    reasons.push({ title: '防暑', desc: `气温 ${temperature}°，选择透气材质并适当防晒。` })
  }
  if (temperature < 10) {
    reasons.push({ title: '防寒', desc: `气温仅 ${temperature}°，注意保暖防风。` })
  }
  if (humidity > 75) {
    reasons.push({ title: '湿度', desc: '空气湿度较高，建议选择透气面料避免闷热感。' })
  }
  if (Math.abs(temperature - feelsLike) >= 3) {
    reasons.push({ title: '体感', desc: `体感温度 ${feelsLike}°，${feelsLike < temperature ? '偏凉' : '偏暖'}，注意调整穿着。` })
  }
  if (reasons.length === 0) {
    reasons.push({ title: '舒适', desc: `今天天气适宜，${temperature}° 体感舒适，轻松出门即可。` })
  }
  reasons.push({ title: '适配通勤', desc: '整体色调克制，适合办公室和下班见面场景。' })

  return reasons.slice(0, 3)
}

/** 根据天气生成今日提醒 */
function buildAgendas(weather: WeatherInfo) {
  const { condition, temperature, high, low } = weather
  const agendas: Array<{ title: string; desc: string }> = []

  agendas.push({
    title: '出门前',
    desc: condition.includes('雨')
      ? '带一把折叠伞，包里预留放湿伞空间。'
      : temperature > 28
        ? '涂好防晒，戴好遮阳帽或墨镜。'
        : '检查外套是否带上，早晚可能需要。'
  })

  agendas.push({
    title: '午间温度',
    desc: high >= 26
      ? '午后气温升至 ' + high + '°，可脱掉外套透气。'
      : '午间温度适中，保持当前搭配即可。'
  })

  agendas.push({
    title: '下班场景',
    desc: low <= 15
      ? '傍晚降温至 ' + low + '°，记得外套别忘在办公室。'
      : '如果临时约饭，加一条配饰即可提升精致感。'
  })

  return agendas
}

/** 瀑布流卡片数据类型 */
interface WaterfallCard {
  id: string
  type: 'outfit' | 'clothing'
  title: string
  scene: string
  record: string
  label: string
  imagePath: string
  tone: string
  size: string
  isVideo: boolean
}

/** 将 tone 映射到 CSS 类名 */
function toneToClass(tone: string): string {
  const valid = ['sage', 'cream', 'denim', 'blush', 'charcoal', 'olive',
    'blue', 'black', 'green', 'brown', 'red', 'pink', 'gray', 'white', 'oat']
  return valid.includes(tone) ? tone : 'oat'
}

/** 从穿搭记录和有穿着记录的衣物生成瀑布流卡片 */
async function buildWaterfallCards(): Promise<WaterfallCard[][]> {
  const cards: WaterfallCard[] = []
  const clothesRes = await fetchAllClothes()
  const clothes: ClothingItem[] = clothesRes.data as any

  // ① 搭配记录 → 卡片
  const outfitsRes = await fetchAllOutfits()
  const outfits: OutfitItem[] = outfitsRes.data as any
  outfits.forEach((o) => {
    const previewImage = clothes.find((item) => o.clothingIds.includes(item.id) && item.imagePath)?.imagePath || ''
    cards.push({
      id: o.id,
      type: 'outfit',
      title: o.description ? `${o.name} · ${o.description}` : o.name,
      scene: o.scene || '搭配记录',
      record: o.wearCount > 0 ? `已穿 ${o.wearCount} 次` : '待穿搭',
      label: o.name.length > 6 ? o.name.slice(0, 6) + '…' : o.name,
      imagePath: previewImage,
      tone: toneToClass(o.tone),
      size: 'tall',
      isVideo: false
    })
  })

  // ② 有穿着记录的衣物 → 卡片
  clothes.filter((c: ClothingItem) => c.wearCount > 0).forEach((c: ClothingItem) => {
    cards.push({
      id: c.id,
      type: 'clothing',
      title: `${c.name}${c.scene ? ' · ' + c.scene : ''}`,
      scene: c.category || '穿搭记录',
      record: `已穿 ${c.wearCount} 次`,
      label: c.category,
      imagePath: c.imagePath || '',
      tone: toneToClass(c.tone),
      size: 'mid',
      isVideo: false
    })
  })

  // ③ 按创建时间倒序排列
  cards.sort((a, b) => {
    const aItem = a.type === 'outfit'
      ? outfits.find((o: OutfitItem) => o.id === a.id)
      : clothes.find((c: ClothingItem) => c.id === a.id)
    const bItem = b.type === 'outfit'
      ? outfits.find((o: OutfitItem) => o.id === b.id)
      : clothes.find((c: ClothingItem) => c.id === b.id)
    const aTime = aItem ? (aItem as any).createdAt || 0 : 0
    const bTime = bItem ? (bItem as any).createdAt || 0 : 0
    return bTime - aTime
  })

  // ④ 分配为双列瀑布流（交替填充）
  const columns: WaterfallCard[][] = [[], []]
  cards.forEach((card, index) => {
    columns[index % 2].push(card)
  })

  return columns
}

/** 天气条件 → 渐变色 */
const WEATHER_GRADIENTS: Record<string, string> = {
  '晴': 'linear-gradient(160deg, var(--color-primary) 0%, #e8a88c 55%, #fce4d6 100%)',
  '多云': 'linear-gradient(160deg, #8e9aaf 0%, #b8c5d6 55%, #e8e0d8 100%)',
  '小雨': 'linear-gradient(160deg, #6b7d8e 0%, #8fa4b5 55%, #c8d6e0 100%)',
  '阴': 'linear-gradient(160deg, #7a8694 0%, #a0adb8 55%, #d0d8de 100%)',
  '大雨': 'linear-gradient(160deg, #4a5568 0%, #6b7d8e 55%, #9ca3af 100%)',
  '雷阵雨': 'linear-gradient(160deg, #5a6577 0%, #7d8a9c 55%, #b0bec5 100%)',
  '雪': 'linear-gradient(160deg, #b0c4de 0%, #d6e5f3 55%, #f0f5fa 100%)',
  '雾': 'linear-gradient(160deg, #9ca3af 0%, #c5ccd4 55%, #e8ebed 100%)',
  '默认': 'linear-gradient(160deg, var(--color-primary) 0%, #e8a88c 55%, #fce4d6 100%)',
}

const WEATHER_THEME_KEYS: Record<string, string> = {
  '晴': 'sunny',
  '多云': 'cloudy',
  '小雨': 'rain',
  '阴': 'overcast',
  '大雨': 'heavy-rain',
  '雷阵雨': 'storm',
  '雪': 'snow',
  '雾': 'fog',
}

createComponent({
  data: {
    activeTab: 'recommend',
    transitionDirection: 'idle',
    statusBarHeight: 44,
    navRightPad: 200,
    touchStartX: 0,
    touchStartY: 0,
    weatherLoading: false,
    weatherGradient: WEATHER_GRADIENTS['默认'],
    homeTabs: [
      { key: 'weather', label: '今日天气' },
      { key: 'recommend', label: '推荐' }
    ],
    weather: {
      city: '上海',
      summary: '天气加载中…',
      temperature: '--',
      low: '--',
      high: '--',
      tags: [] as string[]
    },
    recommendation: {
      title: '加载中',
      description: '正在获取天气数据…',
      scene: '',
      items: [] as Array<{ name: string; role: string; reason: string; fromWardrobe: boolean; clothingId?: string }>
    },
    waterfallColumns: [] as WaterfallCard[][],
    reasons: [] as Array<{ title: string; desc: string }>,
    agendas: [] as Array<{ title: string; desc: string }>,
    wardrobeMatchCount: 0,
    matchedOutfitIds: [] as string[],
    wardrobeEmpty: false
  },
  attached() {
    // 获取状态栏高度和胶囊按钮位置
    if (typeof wx !== 'undefined' && typeof wx.getSystemInfoSync === 'function') {
      const systemInfo = wx.getSystemInfoSync()
      this.setData({
        statusBarHeight: systemInfo.statusBarHeight || 44
      })

      // 计算导航栏右侧 padding，避免被胶囊按钮遮挡
      try {
        const menuButton = wx.getMenuButtonBoundingClientRect()
        // 胶囊按钮右侧到屏幕右侧的距离 + 胶囊宽度 + 左侧间距
        const rightPad = (systemInfo.screenWidth || 375) - menuButton.left + 16
        this.setData({ navRightPad: rightPad })
      } catch {
        // 降级处理：使用默认值
      }
    }

    // 加载真实瀑布流数据
    buildWaterfallCards().then((columns) => {
      this.setData({ waterfallColumns: columns })
    })

    // 加载天气数据
    this.loadWeather()
  },

  pageLifetimes: {
    show() {
      buildWaterfallCards().then((columns) => {
        this.setData({ waterfallColumns: columns })
      })
    }
  },

  methods: {
    onTapNavSearch() {
      this.setHomeTab('recommend')
    },

    onTapNavCalendar() {
      wx.navigateTo({
        url: '/pages/calendarPage/index'
      })
    },

    async loadWeather() {
      this.setData({ weatherLoading: true })

      try {
        // 先尝试获取用户位置
        const location = await getCurrentLocation()
        const weatherData = await getWeatherInfo(
          location?.longitude,
          location?.latitude
        )

        // 生成基于天气的推荐数据，并与衣橱匹配
        const rawRec = buildRecommendation(weatherData)
        const clothesRes = await fetchAllClothes()
        const clothes = clothesRes.data
        const recommendation = {
          ...rawRec,
          items: matchWardrobe(rawRec.items, clothes)
        }
        const wardrobeMatchCount = recommendation.items.filter((i) => i.fromWardrobe).length
        const reasons = buildReasons(weatherData)
        const agendas = buildAgendas(weatherData)

        const wardrobeEmpty = clothes.length === 0

        this.setData({
          weather: {
            city: weatherData.city,
            summary: weatherData.summary,
            temperature: String(weatherData.temperature),
            low: String(weatherData.low),
            high: String(weatherData.high),
            tags: weatherData.tags
          },
          weatherGradient: WEATHER_GRADIENTS[weatherData.condition] || WEATHER_GRADIENTS['默认'],
          recommendation,
          reasons,
          agendas,
          wardrobeMatchCount,
          wardrobeEmpty,
          weatherLoading: false
        })
      } catch (error) {
        console.error('[Weather] 加载失败:', error)
        this.setData({
          weather: {
            city: '上海',
            summary: '天气数据加载失败，请检查网络',
            temperature: '--',
            low: '--',
            high: '--',
            tags: []
          },
          weatherLoading: false
        })
      }
    },
    switchHomeTab(event: HomeTabEvent) {
      this.setHomeTab(event.currentTarget.dataset.tab)
    },
    setHomeTab(tab: string) {
      if (tab === this.data.activeTab) return

      const activeIndex = homeTabKeys.indexOf(this.data.activeTab)
      const nextIndex = homeTabKeys.indexOf(tab)
      if (nextIndex < 0) return

      this.setData({
        activeTab: tab,
        transitionDirection: nextIndex > activeIndex ? 'forward' : 'backward'
      })

      // 切换到推荐tab时刷新瀑布流数据
      if (tab === 'recommend') {
        buildWaterfallCards().then((columns) => {
          this.setData({ waterfallColumns: columns })
        })
      }
    },
    handleTabTouchStart(event: HomeTouchEvent) {
      const touchPoint = event.touches && event.touches[0]
      if (!touchPoint) return

      this.setData({
        touchStartX: touchPoint.clientX,
        touchStartY: touchPoint.clientY
      })
    },
    handleTabTouchEnd(event: HomeTouchEvent) {
      const touchPoint = event.changedTouches && event.changedTouches[0]
      if (!touchPoint) return

      const deltaX = touchPoint.clientX - this.data.touchStartX
      const deltaY = touchPoint.clientY - this.data.touchStartY
      const isHorizontalSwipe = Math.abs(deltaX) > 70 && Math.abs(deltaX) > Math.abs(deltaY) * 1.4
      if (!isHorizontalSwipe) return

      const activeIndex = homeTabKeys.indexOf(this.data.activeTab)
      const nextIndex = deltaX < 0 ? activeIndex + 1 : activeIndex - 1
      const nextTab = homeTabKeys[nextIndex]
      if (nextTab) {
        this.setHomeTab(nextTab)
      }
    },

    /** 点击衣橱匹配单品 → 跳转详情 */
    goClothingDetail(e: { currentTarget: { dataset: { id: string } } }) {
      const id = e.currentTarget.dataset.id
      if (id) {
        wx.navigateTo({ url: `/pages/clothingDetailPage/index?id=${id}` })
      }
    },

    /** 点击空衣橱引导 → 跳转添加衣物 */
    goAddClothes() {
      wx.navigateTo({ url: '/pages/addClothesPage/index' })
    },

    /** 点击瀑布流卡片 → 跳转搭配/衣物详情 */
    goWaterfallCard(e: { currentTarget: { dataset: { id: string; type: string } } }) {
      const { id, type } = e.currentTarget.dataset
      if (type === 'outfit') {
        wx.navigateTo({ url: `/pages/outfitDetailPage/index?id=${id}` })
      } else if (type === 'clothing') {
        wx.navigateTo({ url: `/pages/clothingDetailPage/index?id=${id}` })
      }
    }
  }
})
</script>

