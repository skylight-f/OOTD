  background: rgba(255, 255, 255, 0.82);
  color: #2d2d2d;
  font-size: 22rpx;
  font-weight: 700;
}

.outfit-body {
  flex: 1;
  min-width: 0;
  padding: 24rpx 24rpx 22rpx;
}

.outfit-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #222222;
}

.outfit-desc {
  display: block;
