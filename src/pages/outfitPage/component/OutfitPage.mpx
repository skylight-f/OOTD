  margin-top: 18rpx;
}

.outfit-card {
  display: flex;
  overflow: hidden;
  margin-bottom: 18rpx;
}

.outfit-card:last-child {
  margin-bottom: 0;
}

.outfit-cover {
  display: flex;
  align-items: flex-end;
  width: 220rpx;
  min-height: 190rpx;
  padding: 18rpx;
  box-sizing: border-box;
}

.outfit-cover--oat { background: linear-gradient(150deg, #e5d7c3, #c4a97d); }
.outfit-cover--blue { background: linear-gradient(150deg, #d8eafa, #769fc4); }
.outfit-cover--cream { background: linear-gradient(150deg, #f5ead5, #d4b896); }
