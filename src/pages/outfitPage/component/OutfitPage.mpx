.outfit-cover--green { background: linear-gradient(150deg, #d7e6dc, #6c8f7a); }
.outfit-cover--brown { background: linear-gradient(150deg, #f4e7dc, #c5936b); }
.outfit-cover--rose { background: linear-gradient(150deg, #ffe2e8, #d58b9b); }
.outfit-cover--red { background: linear-gradient(150deg, #fce4ec, #d4a0a0); }
.outfit-cover--pink { background: linear-gradient(150deg, #fce4ec, #e0b8c4); }
.outfit-cover--gray { background: linear-gradient(150deg, #e8e8e8, #b5b5b5); }
.outfit-cover--white { background: linear-gradient(150deg, #f8f8f8, #e0e0e0); }

.outfit-label {
  padding: 8rpx 12rpx;
