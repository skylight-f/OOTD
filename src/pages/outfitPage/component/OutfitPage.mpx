  display: block;
  margin-top: 14rpx;
  font-size: 38rpx;
  line-height: 1.38;
  color: #222222;
  font-weight: 700;
}

.create-btn {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 2rpx dashed #ff2442;
}

