  padding: 34rpx 30rpx;
}

.eyebrow {
  color: #ff2442;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 14rpx;
  font-size: 38rpx;
  line-height: 1.38;
  color: #222222;
  font-weight: 700;
}

.create-btn {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 2rpx dashed #ff2442;
}

.create-btn--pressed { opacity: 0.8; }

.create-btn-icon {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff2442;
  line-height: 1;
}

.create-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff2442;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 76rpx;
  margin-top: 18rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  font-size: 24rpx;
  color: #a3a3a3;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #222222;
}

.search-clear {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  line-height: 34rpx;
  text-align: center;
  background: #f2f2f2;
  color: #7d7d7d;
  font-size: 18rpx;
}

.scene-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.scene-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #777777;
  font-size: 22rpx;
}

.scene-chip--active {
  background: #ff2442;
  color: #ffffff;
}

.empty-state {
  margin-top: 40rpx;
  padding: 60rpx 40rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #555555;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
}

.outfit-list {
  margin-top: 18rpx;
}

.outfit-card {
  display: flex;
  overflow: hidden;
  margin-bottom: 18rpx;
  border-radius: 8rpx;
  background: #ffffff;
  position: relative;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.05);
  animation: fadeSlideUp 0.4s ease-out backwards;
}

.outfit-card:nth-child(1) { animation-delay: 0.05s; }
.outfit-card:nth-child(2) { animation-delay: 0.1s; }
.outfit-card:nth-child(3) { animation-delay: 0.15s; }
.outfit-card:nth-child(4) { animation-delay: 0.2s; }
.outfit-card:nth-child(5) { animation-delay: 0.25s; }

@keyframes fadeSlideUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.outfit-card:last-child {
  margin-bottom: 0;
}

.outfit-card--swiped .outfit-card-inner {
  transform: translateX(-160rpx);
}

.outfit-card-inner {
  display: flex;
  flex: 1;
  position: relative;
  z-index: 2;
  background: #ffffff;
  transition: transform 0.3s ease;
}

.outfit-cover {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  display: flex;
  align-items: flex-end;
  padding: 14rpx;
  box-sizing: border-box;
}

.outfit-cover--oat { background: linear-gradient(135deg, #e5d7c3, #f6efe6); }
.outfit-cover--blue { background: linear-gradient(135deg, #bfd0e3, #edf4fb); }
.outfit-cover--cream { background: linear-gradient(135deg, #e6dccd, #fbf7ef); }
.outfit-cover--black { background: linear-gradient(135deg, #535252, #989592); }
.outfit-cover--green { background: linear-gradient(135deg, #bfd0c6, #f0f7f2); }
.outfit-cover--brown { background: linear-gradient(135deg, #c5936b, #f4e7dc); }
.outfit-cover--red { background: linear-gradient(135deg, #d4a0a0, #f5e6e6); }
.outfit-cover--pink { background: linear-gradient(135deg, #e0b8c4, #f8edf2); }
.outfit-cover--gray { background: linear-gradient(135deg, #b5b5b5, #e8e8e8); }
.outfit-cover--white { background: linear-gradient(135deg, #e8e8e8, #f8f8f8); }

.outfit-label {
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
  color: #2d2d2d;
  font-weight: 600;
}

.outfit-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 20rpx 24rpx;
  min-width: 0;
}

.outfit-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #222222;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.outfit-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #777777;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.outfit-count {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}

.outfit-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ff3b30;
  z-index: 1;
}

.outfit-delete-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}
</style>

<script type="application/json">
  {
    "component": true
  }
</script>
