<template>
  <view class="page outfit-page">
    <view class="hero-card">
      <text class="eyebrow">搭配记录</text>
      <text class="hero-title">把常穿公式沉淀下来，明天出门更快。</text>
    </view>

    <!-- 新建按钮 -->
    <view class="create-btn" bindtap="goCreate" hover-class="create-btn--pressed">
      <text class="create-btn-icon">+</text>
      <text class="create-btn-text">新建搭配</text>
    </view>

    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索搭配名称、场景或描述"
        value="{{searchKey}}"
        bindinput="onSearchInput"
        confirm-type="search"
      />
      <text wx:if="{{searchKey}}" class="search-clear" bindtap="clearSearch">✕</text>
    </view>

    <view class="scene-filter">
      <text
        wx:for="{{sceneFilters}}"
        wx:key="*this"
        class="scene-chip {{activeScene === item ? 'scene-chip--active' : ''}}"
        data-scene="{{item}}"
        bindtap="onTapScene"
      >{{item}}</text>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{outfits.length === 0}}" class="empty-state">
      <text class="empty-title">{{emptyTitle}}</text>
      <text class="empty-desc">{{emptyDesc}}</text>
    </view>

    <!-- 搭配列表 -->
    <view wx:else class="outfit-list">
      <view
        wx:for="{{outfits}}"
        wx:key="id"
        class="outfit-card {{swipeId === item.id ? 'outfit-card--swiped' : ''}}"
        data-id="{{item.id}}"
        bindtap="goDetail"
        bindtouchstart="onSwipeStart"
        bindtouchend="onSwipeEnd"
      >
        <view class="outfit-card-inner">
          <view class="outfit-cover outfit-cover--{{item.tone}}">
            <text class="outfit-label">{{item.scene}}</text>
          </view>
          <view class="outfit-body">
            <text class="outfit-title">{{item.name}}</text>
            <text class="outfit-desc">{{item.description || '暂无描述'}}</text>
            <text class="outfit-count">{{item.clothingIds.length}} 件单品</text>
          </view>
        </view>
        <view class="outfit-delete" data-id="{{item.id}}" catchtap="onDeleteOutfit">
          <text class="outfit-delete-text">删除</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script lang="ts">
import { createComponent } from '@mpxjs/core'
import { getAllOutfits, deleteOutfit, type OutfitItem } from '@/utils/storage'

/** 将搭配与衣物信息组合为卡片展示数据 */
function buildOutfitCards(outfits: OutfitItem[]): Array<{
  id: string
  name: string
  scene: string
  description: string
  tone: string
  clothingIds: string[]
}> {
  return outfits.map((o) => ({
    id: o.id,
    name: o.name,
    scene: o.scene,
    description: o.description,
    tone: o.tone,
    clothingIds: o.clothingIds
  }))
}

createComponent({
  data: {
    allOutfits: [] as ReturnType<typeof buildOutfitCards>,
    outfits: [] as ReturnType<typeof buildOutfitCards>,
    sceneFilters: ['全部'] as string[],
    activeScene: '全部',
    searchKey: '',
    emptyTitle: '还没有搭配记录',
    emptyDesc: '从衣橱选择单品，创建你的第一组搭配公式',
    swipeId: '',
    touchStartX: 0
  },

  attached() {
    this.refreshData()
  },

  pageLifetimes: {
    show() {
      this.refreshData()
    }
  },

  methods: {
    applyFilters() {
      const { allOutfits, activeScene, searchKey } = this.data
      const key = searchKey.trim().toLowerCase()

      let filtered = allOutfits
      if (activeScene !== '全部') {
        filtered = filtered.filter((item) => item.scene === activeScene)
      }

      if (key) {
        filtered = filtered.filter((item) =>
          item.name.toLowerCase().includes(key) ||
          item.scene.toLowerCase().includes(key) ||
          item.description.toLowerCase().includes(key)
        )
      }

      this.setData({
        outfits: filtered,
        emptyTitle: key || activeScene !== '全部' ? '没有匹配的搭配' : '还没有搭配记录',
        emptyDesc: key || activeScene !== '全部'
          ? '试试切换筛选条件或清空关键词'
          : '从衣橱选择单品，创建你的第一组搭配公式'
      })
    },

    refreshData() {
      const outfits = getAllOutfits()
      const cards = buildOutfitCards(outfits)
      const sceneFilters = ['全部', ...Array.from(new Set(cards.map((item) => item.scene))).filter(Boolean)]

      this.setData({ allOutfits: cards, sceneFilters })
      this.applyFilters()
    },

    onSearchInput(e: { detail: { value: string } }) {
      this.setData({ searchKey: e.detail.value })
      this.applyFilters()
    },

    clearSearch() {
      this.setData({ searchKey: '' })
      this.applyFilters()
    },

    onTapScene(e: { currentTarget: { dataset: { scene: string } } }) {
      this.setData({ activeScene: e.currentTarget.dataset.scene })
      this.applyFilters()
    },

    goCreate() {
      wx.navigateTo({ url: '/pages/outfitCreatePage/index' })
    },

    /** 触摸开始 */
    onSwipeStart(e: { touches: Array<{ clientX: number }> }) {
      this.setData({
        touchStartX: e.touches[0].clientX
      })
    },

    /** 触摸结束，判断滑动方向 */
    onSwipeEnd(e: { changedTouches: Array<{ clientX: number }>; currentTarget: { dataset: { id: string } } }) {
      const deltaX = e.changedTouches[0].clientX - this.data.touchStartX
      if (deltaX < -50) {
        this.setData({ swipeId: e.currentTarget.dataset.id })
      } else if (deltaX > 30) {
        this.setData({ swipeId: '' })
      }
    },

    /** 删除搭配 */
    onDeleteOutfit(e: { currentTarget: { dataset: { id: string } } }) {
      const id = e.currentTarget.dataset.id
      wx.showModal({
        title: '确认删除',
        content: '删除后无法恢复，是否继续？',
        success: (res) => {
          if (res.confirm) {
            deleteOutfit(id)
            this.refreshData()
            wx.showToast({ title: '已删除', icon: 'success' })
          }
          this.setData({ swipeId: '' })
        }
      })
    },

    goDetail(e: { currentTarget: { dataset: { id: string } } }) {
      if (this.data.swipeId === e.currentTarget.dataset.id) {
        this.setData({ swipeId: '' })
        return
      }
      wx.navigateTo({ url: `/pages/outfitDetailPage/index?id=${e.currentTarget.dataset.id}` })
    }
  }
})
</script>

<style lang="less">
.page {
  min-height: 100vh;
  padding: 32rpx 24rpx 170rpx;
  background: #f6f6f6;
  box-sizing: border-box;
}

.hero-card,
.outfit-card {
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.05);
}

