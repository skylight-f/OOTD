<template>
  <view class="page closet-dashboard-page">
    <view class="summary-card">
      <text class="eyebrow">衣橱数据看板</text>
      <text class="summary-title">本季衣橱利用率 {{utilizationRate}}%</text>
      <text class="summary-desc">基于你的单品、常穿频率和场景覆盖，整理出更容易复穿的搭配方向。</text>
      <view class="summary-grid">
        <view wx:for="{{overviewStats}}" wx:key="label" class="summary-stat">
          <text class="summary-value">{{item.value}}</text>
          <text class="summary-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <text class="section-title">分类占比</text>
        <text class="section-subtitle">按当前录入单品</text>
      </view>
      <view wx:if="{{categoryBars.length === 0}}" class="empty-hint">
        <text class="empty-hint-text">暂无衣物数据</text>
      </view>
      <view wx:else class="bar-list">
        <view wx:for="{{categoryBars}}" wx:key="label" class="bar-item">
          <view class="bar-row">
            <text class="bar-label">{{item.label}}</text>
            <text class="bar-value">{{item.value}} 件</text>
          </view>
          <view class="bar-track">
            <view class="bar-fill bar-fill--{{item.tone}}" style="width: {{item.rate}}%;"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <text class="section-title">场景覆盖</text>
        <text class="section-subtitle">按衣物场景标签</text>
      </view>
      <view wx:if="{{sceneStats.length === 0}}" class="empty-hint">
        <text class="empty-hint-text">暂无场景数据</text>
      </view>
      <view wx:else class="scene-grid">
        <view wx:for="{{sceneStats}}" wx:key="label" class="scene-card">
          <text class="scene-value">{{item.value}}</text>
          <text class="scene-label">{{item.label}}</text>
          <text class="scene-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">复穿建议</text>
      <view wx:if="{{insights.length === 0}}" class="empty-hint">
        <text class="empty-hint-text">添加更多衣物后会生成复穿建议</text>
      </view>
      <view wx:else class="insight-list">
        <view wx:for="{{insights}}" wx:key="title" class="insight-item">
          <text class="insight-title">{{item.title}}</text>
          <text class="insight-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script lang="ts">
import { createComponent } from '@mpxjs/core'
import { getAllClothes, getAllOutfits, getClothingStats, CATEGORY_OPTIONS, type ClothingItem } from '@/utils/storage'

interface CategoryBar {
  label: string
  value: number
  rate: number
  tone: string
}

interface SceneStat {
  label: string
  value: string
  desc: string
}

interface Insight {
  title: string
  desc: string
}

function buildCategoryBars(clothes: ClothingItem[]): CategoryBar[] {
  if (clothes.length === 0) return []

  const toneMap: Record<string, string> = {
    '上装': 'green', '下装': 'blue', '外套': 'gold',
    '鞋包': 'rose', '配饰': 'dark'
  }

  const counts: Record<string, number> = {}
  clothes.forEach((c) => {
    counts[c.category] = (counts[c.category] || 0) + 1
  })

  const maxCount = Math.max(...Object.values(counts))

  return CATEGORY_OPTIONS
    .filter((cat) => counts[cat])
    .map((cat) => {
      const count = counts[cat]
      const label = cat === '鞋履' ? '鞋包' : cat === '包袋' ? '鞋包' : cat
      return {
        label,
        value: count,
        rate: Math.round((count / maxCount) * 100),
        tone: toneMap[cat] || 'green'
      }
    })
    .reduce((acc: CategoryBar[], item) => {
      const existing = acc.find((a) => a.label === item.label)
      if (existing) {
        existing.value += item.value
        existing.rate = Math.round((existing.value / maxCount) * 100)
      } else {
        acc.push(item)
      }
      return acc
    }, [])
}

function buildSceneStats(clothes: ClothingItem[]): SceneStat[] {
  if (clothes.length === 0) return []

  const sceneCounts: Record<string, number> = {}
  let totalScenes = 0

  clothes.forEach((c) => {
    const scenes = c.scene.split(' / ').map((s) => s.trim()).filter(Boolean)
    scenes.forEach((s) => {
      sceneCounts[s] = (sceneCounts[s] || 0) + 1
      totalScenes++
    })
  })

  const descMap: Record<string, string> = {
    '通勤': '覆盖最完整',
    '周末': '偏休闲基础款',
    '约会': '可增加亮色单品',
    '运动': '可补轻便外套',
    '正式': '搭配较为完整',
    '休闲': '基础款为主',
    '旅行': '便携搭配为主',
    '居家': '舒适优先'
  }

  return Object.entries(sceneCounts)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 4)
    .map(([scene, count]) => ({
      label: scene,
      value: `${Math.round((count / totalScenes) * 100)}%`,
      desc: descMap[scene] || '搭配记录'
    }))
}

function buildInsights(clothes: ClothingItem[], outfits: ReturnType<typeof getAllOutfits>): Insight[] {
  const insights: Insight[] = []

  if (clothes.length === 0) {
    insights.push({
      title: '开始添加衣物',
      desc: '添加更多衣物后，系统会根据穿着频率和场景覆盖生成个性化复穿建议。'
    })
    return insights
  }

  const mostWorn = clothes
    .filter((c) => c.wearCount > 0)
    .sort((a, b) => b.wearCount - a.wearCount)
    .slice(0, 3)

  if (mostWorn.length > 0) {
    const names = mostWorn.map((c) => c.name).join('、')
    insights.push({
      title: '高频单品',
      desc: `${names}复穿率较高，可以围绕这些单品继续生成搭配公式。`
    })
  }

  const categories = new Set(clothes.map((c) => c.category))
  if (categories.size < 4) {
    insights.push({
      title: '品类待补充',
      desc: `当前覆盖 ${categories.size} 个品类，建议补充${categories.has('鞋履') ? '' : '鞋履'}${categories.has('配饰') ? '' : '配饰'}等品类提升搭配灵活度。`
    })
  }

  const scenes = new Set<string>()
  clothes.forEach((c) => {
    c.scene.split(' / ').map((s) => s.trim()).forEach((s) => scenes.add(s))
  })

  if (scenes.size < 3 && clothes.length >= 5) {
    insights.push({
      title: '场景覆盖待扩展',
      desc: '当前衣物场景较为集中，可补充适合不同场合的单品。'
    })
  }

  const unfavored = clothes.filter((c) => !c.favorite && c.wearCount === 0)
  if (unfavored.length >= 3) {
    insights.push({
      title: '闲置单品提醒',
      desc: `有 ${unfavored.length} 件衣物尚未穿着过，可以尝试搭配或考虑清理。`
    })
  }

  if (insights.length === 0) {
    insights.push({
      title: '搭配表现良好',
      desc: '你的衣橱利用较为均衡，继续保持！'
    })
  }

  return insights.slice(0, 3)
}

function calcUtilization(clothes: ClothingItem[]): number {
  if (clothes.length === 0) return 0
  const worn = clothes.filter((c) => c.wearCount > 0).length
  return Math.round((worn / clothes.length) * 100)
}

createComponent({
  data: {
    utilizationRate: 0,
    overviewStats: [
      { label: '总单品', value: '0' },
      { label: '本季可穿', value: '0' },
      { label: '高频单品', value: '0' },
      { label: '待整理', value: '0' }
    ],
    categoryBars: [] as CategoryBar[],
    sceneStats: [] as SceneStat[],
    insights: [] as Insight[]
  },

  attached() {
    this.refreshData()
  },

  methods: {
    refreshData() {
      const clothes = getAllClothes()
      const outfits = getAllOutfits()
      const statsData = getClothingStats()

      const wornClothes = clothes.filter((c) => c.wearCount > 0)
      const highFreq = wornClothes.filter((c) => c.wearCount >= 3).length
      const neverWorn = clothes.filter((c) => c.wearCount === 0).length

      this.setData({
        utilizationRate: calcUtilization(clothes),
        overviewStats: [
          { label: '总单品', value: String(statsData.total) },
          { label: '本季可穿', value: String(statsData.seasonCount) },
          { label: '高频单品', value: String(highFreq) },
          { label: '待整理', value: String(neverWorn) }
        ],
        categoryBars: buildCategoryBars(clothes),
        sceneStats: buildSceneStats(clothes),
        insights: buildInsights(clothes, outfits)
      })
    }
  }
})
</script>

<style lang="less">
