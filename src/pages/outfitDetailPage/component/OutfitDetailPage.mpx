  width: 16rpx;
  flex-shrink: 0;
}

.hero-tone--oat { background: #e5d7c3; }
.hero-tone--blue { background: #769fc4; }
.hero-tone--cream { background: #d4b896; }
.hero-tone--black { background: #535252; }
.hero-tone--green { background: #6c8f7a; }
.hero-tone--brown { background: #c5936b; }
