<template>
  <view class="page detail-page">
    <!-- 空状态 -->
    <view wx:if="{{!outfit}}" class="empty">
      <text class="empty-text">搭配不存在</text>
    </view>

    <view wx:else class="detail-content">
      <!-- 搭配信息头部 -->
      <view class="hero-card">
        <view class="hero-tone hero-tone--{{outfit.tone}}"></view>
        <view class="hero-info">
          <text class="hero-scene">{{outfit.scene}}</text>
          <text class="hero-name">{{outfit.name}}</text>
          <text wx:if="{{outfit.description}}" class="hero-desc">{{outfit.description}}</text>
        </view>
      </view>

      <!-- 包含的单品 -->
      <view class="section-card">
        <view class="section-head">
          <text class="section-title">包含单品（{{clothesList.length}} 件）</text>
        </view>

        <view wx:if="{{clothesList.length === 0}}" class="hint">
          <text class="hint-text">该搭配中的衣物已被删除</text>
        </view>

        <view wx:else class="clothes-row">
          <view
            wx:for="{{clothesList}}"
            wx:key="id"
            class="cloth-card"
            data-id="{{item.id}}"
            bindtap="goClothingDetail"
          >
            <view class="cloth-cover cloth-cover--{{item.tone}}">
              <image wx:if="{{item.imagePath}}" class="cloth-image" src="{{item.imagePath}}" mode="aspectFill" />
              <text wx:else class="cloth-icon">{{item.icon}}</text>
            </view>
            <text class="cloth-name">{{item.name}}</text>
            <text class="cloth-meta">{{item.category}} · {{item.color}}</text>
          </view>
        </view>
      </view>

      <!-- 穿着统计 -->
      <view class="section-card stats-card">
        <text class="section-title">穿着统计</text>
        <view class="detail-stats">
          <view class="detail-stat">
            <text class="detail-stat-value">{{outfit.wearCount}}</text>
            <text class="detail-stat-label">穿着次数</text>
          </view>
          <view class="detail-stat">
            <text class="detail-stat-value">{{lastWornText}}</text>
            <text class="detail-stat-label">最后一次穿着</text>
          </view>
          <view class="detail-stat">
            <text class="detail-stat-value">{{createdText}}</text>
            <text class="detail-stat-label">创建时间</text>
          </view>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="action-row">
        <view class="action-btn action-btn--wear" bindtap="handleWear" hover-class="action-btn--pressed">
          <text class="action-text">记录穿着</text>
        </view>
        <view class="action-btn action-btn--delete" bindtap="showDeleteConfirm" hover-class="action-btn--pressed">
          <text class="action-text">删除搭配</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script lang="ts">
import { createComponent } from '@mpxjs/core'
import { getAllOutfits, deleteOutfit, getClothingById, inferTone, categoryToIcon, recordOutfitWear, type OutfitItem, type ClothingItem } from '@/utils/storage'

function formatDate(timestamp: number): string {
  if (!timestamp) return '暂无记录'
  const d = new Date(timestamp)
  const month = d.getMonth() + 1
  const day = d.getDate()
  return `${month}月${day}日`
}

interface DisplayCloth {
  id: string; name: string; category: string; color: string; tone: string; icon: string; imagePath: string
}

function toDisplay(item: ClothingItem): DisplayCloth {
  return {
    id: item.id, name: item.name, category: item.category, color: item.color,
    tone: item.tone || inferTone(item.color), icon: categoryToIcon(item.category), imagePath: item.imagePath
  }
}

createComponent({
  properties: {
    outfitId: String
  },

  data: {
    outfit: null as OutfitItem | null,
    clothesList: [] as DisplayCloth[],
    lastWornText: '暂无记录',
    createdText: ''
  },

  observers: {
    outfitId(id: string) {
      if (!id) return

      const outfits = getAllOutfits()
      const outfit = outfits.find((o) => o.id === id)
      if (!outfit) {
        wx.showToast({ title: '搭配不存在', icon: 'none' })
        setTimeout(() => wx.navigateBack(), 500)
        return
      }

      const list = outfit.clothingIds
        .map((cid) => getClothingById(cid))
        .filter(Boolean)
        .map((c) => toDisplay(c!))

      this.setData({
        outfit,
        clothesList: list,
        lastWornText: formatDate(outfit.lastWornAt),
        createdText: formatDate(outfit.createdAt)
      })
    }
  },

  methods: {
    goClothingDetail(e: { currentTarget: { dataset: { id: string } } }) {
      wx.navigateTo({ url: `/pages/clothingDetailPage/index?id=${e.currentTarget.dataset.id}` })
    },

    handleWear() {
      const outfit = this.data.outfit
      if (!outfit) return

      const success = recordOutfitWear(outfit.id)
      if (!success) {
        wx.showToast({ title: '记录失败', icon: 'none' })
        return
      }

      const updatedOutfit = getAllOutfits().find((item) => item.id === outfit.id) || outfit
      this.setData({
        outfit: updatedOutfit,
        lastWornText: formatDate(updatedOutfit.lastWornAt),
        createdText: formatDate(updatedOutfit.createdAt)
      })
      wx.showToast({ title: '已记录穿着', icon: 'success' })
    },

    showDeleteConfirm() {
      const outfit = this.data.outfit
      if (!outfit) return
      wx.showModal({
        title: '确认删除',
        content: `确定要删除「${outfit.name}」吗？`,
        confirmText: '删除',
        confirmColor: '#ff2442',
        success: (res: any) => {
          if (res.confirm) {
            deleteOutfit(outfit.id)
            wx.showToast({ title: '已删除', icon: 'success' })
            setTimeout(() => wx.navigateBack(), 800)
          }
        }
      })
    }
  }
})
</script>

