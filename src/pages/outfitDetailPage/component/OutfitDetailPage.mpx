.cloth-cover--gray { background: linear-gradient(180deg, #b5b5b5, #e8e8e8); }
.cloth-cover--white { background: linear-gradient(180deg, #e8e8e8, #f8f8f8); }

.cloth-image { width: 100%; height: 100%; }

