<template>
  <view class="page create-page">
    <!-- 已选衣物 -->
    <view class="section-card">
      <text class="section-title">已选衣物（{{selectedIds.length}} 件）</text>

      <view wx:if="{{selectedIds.length === 0}}" class="empty-hint">
        <text class="empty-hint-text">还没有选择衣物，请从下方添加</text>
      </view>

      <view wx:else class="selected-grid">
        <view wx:for="{{selectedClothes}}" wx:key="id" class="selected-item">
          <view class="selected-cover selected-cover--{{item.tone}}">
            <image wx:if="{{item.imagePath}}" class="selected-image" src="{{item.imagePath}}" mode="aspectFill" />
            <text wx:else class="selected-icon">{{item.icon}}</text>
            <view class="selected-remove" data-id="{{item.id}}" catchtap="onRemoveCloth">
              <text class="selected-remove-text">✕</text>
            </view>
          </view>
          <text class="selected-name">{{item.name}}</text>
        </view>
      </view>

      <!-- 两个入口按钮 -->
      <view class="action-row">
        <view class="action-btn action-btn--select" bindtap="onOpenPicker">
          <text class="action-btn-text">选择衣服</text>
        </view>
        <view class="action-btn action-btn--add" bindtap="onOpenAddForm">
          <text class="action-btn-text">新增衣服</text>
        </view>
      </view>
    </view>

    <!-- 搭配信息 -->
    <view class="section-card">
      <text class="section-title">搭配信息</text>

      <view class="form-field">
        <text class="field-label">搭配名称</text>
        <input class="field-input" placeholder="如：雨天通勤、周末散步" value="{{form.name}}" data-field="name" bindinput="handleInput" />
      </view>

      <view class="form-field">
        <text class="field-label">适合场景</text>
        <view class="scene-tags">
          <text
            wx:for="{{sceneOptions}}"
            wx:key="*this"
            class="scene-tag {{selectedScene === item ? 'scene-tag--active' : ''}}"
            data-scene="{{item}}"
            bindtap="selectScene"
          >{{item}}</text>
        </view>
      </view>

      <view class="form-field">
        <text class="field-label">描述</text>
        <textarea class="field-textarea" placeholder="简单描述这组搭配" value="{{form.description}}" data-field="description" bindinput="handleInput" maxlength="200" />
      </view>

      <view class="save-btn" bindtap="handleSave" hover-class="save-btn--pressed">
        <text class="save-btn-text">保存搭配</text>
      </view>
    </view>

    <!-- 选择衣服弹窗（底部 60%） -->
    <view class="picker-mask" wx:if="{{showPicker}}" bindtap="onClosePicker"></view>
    <view class="picker-sheet {{showPicker ? 'picker-sheet--show' : ''}}">
      <view class="picker-header">
        <text class="picker-title">选择衣物</text>
        <text class="picker-close" bindtap="onClosePicker">完成</text>
      </view>

      <view wx:if="{{allClothes.length === 0}}" class="picker-empty">
        <text class="picker-empty-text">衣橱还没有衣物</text>
      </view>

      <scroll-view wx:else class="picker-list" scroll-y>
        <view
          wx:for="{{allClothes}}"
          wx:key="id"
          class="picker-item {{selectedIds.indexOf(item.id) >= 0 ? 'picker-item--selected' : ''}}"
          data-id="{{item.id}}"
          bindtap="onTogglePickerItem"
        >
          <view class="picker-cover picker-cover--{{item.tone}}">
            <image wx:if="{{item.imagePath}}" class="picker-image" src="{{item.imagePath}}" mode="aspectFill" />
            <text wx:else class="picker-icon">{{item.icon}}</text>
          </view>
          <view class="picker-info">
            <text class="picker-name">{{item.name}}</text>
            <text class="picker-meta">{{item.category}} · {{item.color}}</text>
          </view>
          <view class="picker-check" wx:if="{{selectedIds.indexOf(item.id) >= 0}}">
            <text class="picker-check-icon">✓</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 新增衣服弹窗 -->
    <view class="picker-mask" wx:if="{{showAddForm}}" bindtap="onCloseAddForm"></view>
    <view class="picker-sheet {{showAddForm ? 'picker-sheet--show' : ''}}">
      <view class="picker-header">
        <text class="picker-title">新增衣服</text>
        <text class="picker-close" bindtap="onCloseAddForm">✕</text>
      </view>

      <scroll-view class="picker-list" scroll-y>
        <!-- 图片选择 -->
        <view class="add-photo-area" bindtap="onTapAddPhoto">
          <image wx:if="{{addForm.imagePath}}" class="add-photo-image" src="{{addForm.imagePath}}" mode="aspectFill" />
          <view wx:else class="add-photo-placeholder">
            <text class="add-photo-icon">📷</text>
            <text class="add-photo-text">点击选择照片</text>
          </view>
        </view>

        <view class="form-field">
          <text class="field-label">衣物名称 *</text>
          <input class="field-input" placeholder="如：燕麦针织开衫" value="{{addForm.name}}" data-field="name" bindinput="handleAddInput" />
        </view>

        <view class="form-field">
          <text class="field-label">颜色</text>
          <input class="field-input" placeholder="如：燕麦白" value="{{addForm.color}}" data-field="color" bindinput="handleAddInput" />
        </view>

        <view class="form-field">
          <text class="field-label">类别</text>
          <picker mode="selector" range="{{categoryOptions}}" value="{{addCategoryIndex}}" bindchange="onAddCategoryChange">
            <view class="field-picker">
              <text class="picker-text">{{categoryOptions[addCategoryIndex]}}</text>
              <text class="picker-arrow">▸</text>
            </view>
          </picker>
        </view>

        <view class="form-field">
          <text class="field-label">季节</text>
          <picker mode="selector" range="{{seasonOptions}}" value="{{addSeasonIndex}}" bindchange="onAddSeasonChange">
            <view class="field-picker">
              <text class="picker-text">{{seasonOptions[addSeasonIndex]}}</text>
              <text class="picker-arrow">▸</text>
            </view>
          </picker>
        </view>

        <view class="form-actions">
          <view class="form-btn form-btn--save" bindtap="onSaveAddCloth">
            <text class="form-btn-text">添加并选中</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</template>

<script lang="ts">
import { createComponent } from '@mpxjs/core'
import { getAllClothes, addClothing, addOutfit, saveImageToTemp, inferTone, categoryToIcon, CATEGORY_OPTIONS, SEASON_OPTIONS, SCENE_OPTIONS, type ClothingItem } from '@/utils/storage'

interface DisplayCloth {
  id: string
  name: string
  category: string
  color: string
  tone: string
  icon: string
  imagePath: string
}

function toDisplayCloth(item: ClothingItem): DisplayCloth {
  return {
    id: item.id,
    name: item.name,
    category: item.category,
    color: item.color,
    tone: item.tone || inferTone(item.color),
    icon: categoryToIcon(item.category),
    imagePath: item.imagePath
  }
}

createComponent({
  data: {
    allClothes: [] as DisplayCloth[],
    selectedIds: [] as string[],
    selectedClothes: [] as DisplayCloth[],
    sceneOptions: SCENE_OPTIONS,
    selectedScene: '',
    form: { name: '', description: '' },

    // 选择弹窗
    showPicker: false,

    // 新增弹窗
    showAddForm: false,
    addForm: { name: '', color: '', imagePath: '' },
    categoryOptions: CATEGORY_OPTIONS,
    addCategoryIndex: 0,
    seasonOptions: SEASON_OPTIONS,
    addSeasonIndex: 0
  },

  pageLifetimes: {
    show() {
      this.loadClothes()
    }
  },

  methods: {
    loadClothes() {
      const all = getAllClothes().map(toDisplayCloth)
      const selected = all.filter((c) => this.data.selectedIds.includes(c.id))
      this.setData({ allClothes: all, selectedClothes: selected })
    },

    updateSelected() {
      const selected = this.data.allClothes.filter((c) => this.data.selectedIds.includes(c.id))
      this.setData({ selectedClothes: selected })
    },

    // 选择弹窗
    onOpenPicker() {
      this.setData({ showPicker: true })
    },

    onClosePicker() {
      this.setData({ showPicker: false })
    },

    onTogglePickerItem(e: { currentTarget: { dataset: { id: string } } }) {
      const id = e.currentTarget.dataset.id
      const ids = [...this.data.selectedIds]
      const idx = ids.indexOf(id)
      if (idx >= 0) {
        ids.splice(idx, 1)
      } else {
        ids.push(id)
      }
      this.setData({ selectedIds: ids })
      this.updateSelected()
    },

    onRemoveCloth(e: { currentTarget: { dataset: { id: string } } }) {
      const id = e.currentTarget.dataset.id
      const ids = this.data.selectedIds.filter((i) => i !== id)
      this.setData({ selectedIds: ids })
      this.updateSelected()
    },

    // 新增弹窗
    onOpenAddForm() {
      this.setData({ showAddForm: true })
    },

    onCloseAddForm() {
      this.setData({ showAddForm: false, addForm: { name: '', color: '', imagePath: '' }, addCategoryIndex: 0, addSeasonIndex: 0 })
    },

    onTapAddPhoto() {
      wx.chooseMedia({
        count: 1,
        mediaType: ['image'],
        sourceType: ['album', 'camera'],
        success: (res) => {
          if (res.tempFiles && res.tempFiles.length > 0) {
            this.setData({ 'addForm.imagePath': res.tempFiles[0].tempFilePath })
          }
        }
      })
    },

    handleAddInput(e: { detail: { value: string }; currentTarget: { dataset: { field: string } } }) {
      this.setData({ [`addForm.${e.currentTarget.dataset.field}`]: e.detail.value })
    },

    onAddCategoryChange(e: { detail: { value: string } }) {
      this.setData({ addCategoryIndex: Number(e.detail.value) })
    },

    onAddSeasonChange(e: { detail: { value: string } }) {
      this.setData({ addSeasonIndex: Number(e.detail.value) })
    },

    onSaveAddCloth() {
      const { addForm, addCategoryIndex, addSeasonIndex, categoryOptions, seasonOptions } = this.data
      if (!addForm.name.trim()) {
        wx.showToast({ title: '请输入衣物名称', icon: 'none' })
        return
      }

      wx.showLoading({ title: '添加中...' })

      const doSave = (imagePath: string) => {
        const newItem = addClothing({
          name: addForm.name.trim(),
          category: categoryOptions[addCategoryIndex],
          color: addForm.color.trim() || '未填写',
          material: '',
          scene: '日常',
          season: seasonOptions[addSeasonIndex],
          imagePath,
          tone: inferTone(addForm.color),
          brand: '', size: '', price: ''
        })

        this.setData({
          selectedIds: [...this.data.selectedIds, newItem.id],
          showAddForm: false,
          addForm: { name: '', color: '', imagePath: '' },
          addCategoryIndex: 0,
          addSeasonIndex: 0
        })

        this.loadClothes()
        wx.hideLoading()
        wx.showToast({ title: '已添加', icon: 'success' })
      }

      if (addForm.imagePath) {
        saveImageToTemp(addForm.imagePath)
          .then((savedPath: string) => doSave(savedPath))
          .catch(() => doSave(addForm.imagePath))
      } else {
        doSave('')
      }
    },

    // 搭配信息
    selectScene(e: { currentTarget: { dataset: { scene: string } } }) {
      this.setData({ selectedScene: e.currentTarget.dataset.scene })
    },

    handleInput(e: { detail: { value: string }; currentTarget: { dataset: { field: string } } }) {
      this.setData({ [`form.${e.currentTarget.dataset.field}`]: e.detail.value })
    },

    handleSave() {
      const { selectedIds, form, selectedScene, selectedClothes } = this.data
      if (selectedIds.length === 0) {
        wx.showToast({ title: '请至少选择一件衣物', icon: 'none' })
        return
      }
      if (!form.name.trim()) {
        wx.showToast({ title: '请输入搭配名称', icon: 'none' })
        return
      }

      const firstCloth = selectedClothes[0]
      const tone = firstCloth ? firstCloth.tone : 'oat'

      addOutfit({
        name: form.name.trim(),
        scene: selectedScene || '日常',
        description: form.description.trim(),
        clothingIds: selectedIds.slice(),
        tone
      })

      wx.showToast({ title: '搭配已保存', icon: 'success' })
      setTimeout(() => {
        wx.switchTab({ url: '/pages/outfitPage/index' })
      }, 800)
    }
  }
})
</script>

<style lang="less">
