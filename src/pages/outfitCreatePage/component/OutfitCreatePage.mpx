<template>
  <view class="page create-page">
    <!-- 衣物选择区域 -->
    <view class="section-card">
      <text class="section-title">选择衣物（{{selectedIds.length}} 件）</text>
      <text class="section-desc">从衣橱中选择搭配单品</text>

      <view wx:if="{{clothes.length === 0}}" class="empty-hint">
        <text class="empty-hint-text">衣橱还没有衣物，先去添加吧</text>
      </view>

      <view wx:else class="clothes-grid">
        <view
          wx:for="{{clothes}}"
          wx:key="id"
          class="cloth-item {{selectedIds.indexOf(item.id) >= 0 ? 'cloth-item--selected' : ''}}"
          data-id="{{item.id}}"
          bindtap="toggleCloth"
        >
          <view class="cloth-cover cloth-cover--{{item.tone}}">
            <image
              wx:if="{{item.imagePath}}"
              class="cloth-image"
              src="{{item.imagePath}}"
              mode="aspectFill"
            />
            <text wx:else class="cloth-icon">{{item.icon}}</text>
            <view wx:if="{{selectedIds.indexOf(item.id) >= 0}}" class="cloth-check">
              <text class="cloth-check-icon">✓</text>
            </view>
          </view>
          <text class="cloth-name">{{item.name}}</text>
          <text class="cloth-meta">{{item.category}}</text>
        </view>
      </view>
    </view>

    <!-- 搭配信息 -->
    <view class="section-card form-card">
      <text class="section-title">搭配信息</text>

      <view class="form-field">
        <text class="field-label">搭配名称</text>
        <input class="field-input" placeholder="如：雨天通勤、周末散步" value="{{form.name}}" data-field="name" bindinput="handleInput" />
      </view>

      <view class="form-field">
        <text class="field-label">适合场景</text>
        <view class="scene-tags">
          <text
            wx:for="{{sceneOptions}}"
            wx:key="*this"
            class="scene-tag {{selectedScene === item ? 'scene-tag--active' : ''}}"
            data-scene="{{item}}"
            bindtap="selectScene"
          >{{item}}</text>
        </view>
      </view>

      <view class="form-field">
        <text class="field-label">描述</text>
        <textarea class="field-textarea" placeholder="简单描述这组搭配的穿着场景或心得" value="{{form.description}}" data-field="description" bindinput="handleInput" maxlength="200" />
      </view>

      <view class="save-btn" bindtap="handleSave" hover-class="save-btn--pressed">
        <text class="save-btn-text">保存搭配</text>
      </view>
    </view>
  </view>
</template>

<script lang="ts">
import { createComponent } from '@mpxjs/core'
import { getAllClothes, addOutfit, inferTone, categoryToIcon, SCENE_OPTIONS, type ClothingItem } from '@/utils/storage'


interface DisplayCloth {
  id: string
  name: string
  category: string
  tone: string
  icon: string
  imagePath: string
}

function toDisplayCloth(item: ClothingItem): DisplayCloth {
  return {
    id: item.id,
    name: item.name,
    category: item.category,
    tone: item.tone || inferTone(item.color),
    icon: categoryToIcon(item.category),
    imagePath: item.imagePath
  }
}

createComponent({
  data: {
    clothes: [] as DisplayCloth[],
    selectedIds: [] as string[],
    sceneOptions: SCENE_OPTIONS,
    selectedScene: '',
    form: {
      name: '',
      description: ''
    }
  },

  attached() {
    this.loadClothes()
  },

  methods: {
    loadClothes() {
      const all = getAllClothes().map(toDisplayCloth)
      this.setData({ clothes: all })
    },

    toggleCloth(e: { currentTarget: { dataset: { id: string } } }) {
      const id = e.currentTarget.dataset.id
      const ids = this.data.selectedIds as string[]
      const idx = ids.indexOf(id)
      if (idx >= 0) {
        ids.splice(idx, 1)
      } else {
        ids.push(id)
      }
      this.setData({ selectedIds: [...ids] })
    },

    selectScene(e: { currentTarget: { dataset: { scene: string } } }) {
      this.setData({ selectedScene: e.currentTarget.dataset.scene })
    },

    handleInput(e: { detail: { value: string }; currentTarget: { dataset: { field: string } } }) {
      this.setData({ [`form.${e.currentTarget.dataset.field}`]: e.detail.value })
    },

    handleSave() {
      const { selectedIds, form, selectedScene, clothes } = this.data
      if (selectedIds.length === 0) {
        wx.showToast({ title: '请至少选择一件衣物', icon: 'none' })
        return
      }
      if (!form.name.trim()) {
        wx.showToast({ title: '请输入搭配名称', icon: 'none' })
        return
      }

      // 根据选中衣物的色调选取第一个作为搭配色调
      const firstCloth = clothes.find((c: DisplayCloth) => selectedIds.includes(c.id))
      const tone = firstCloth ? firstCloth.tone : 'oat'

      addOutfit({
        name: form.name.trim(),
        scene: selectedScene || '日常',
        description: form.description.trim(),
        clothingIds: selectedIds.slice(),
        tone
      })

      wx.showToast({ title: '搭配已保存', icon: 'success' })
      setTimeout(() => wx.navigateBack(), 800)
    }
  }
})
</script>

<style lang="less">
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  background: #f6f6f6;
  box-sizing: border-box;
}

.section-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #222222;
}

.section-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}

.empty-hint {
  margin-top: 32rpx;
  padding: 40rpx;
  text-align: center;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.empty-hint-text {
  font-size: 24rpx;
  color: #999999;
}

.clothes-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.cloth-item {
  width: calc(25% - 12rpx);
  padding: 12rpx;
  border-radius: 12rpx;
  background: #fafafa;
  box-sizing: border-box;
  border: 3rpx solid transparent;
  animation: fadeSlideUp 0.35s ease-out backwards;
  transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
}

.cloth-item:nth-child(1) { animation-delay: 0.03s; }
.cloth-item:nth-child(2) { animation-delay: 0.06s; }
.cloth-item:nth-child(3) { animation-delay: 0.09s; }
.cloth-item:nth-child(4) { animation-delay: 0.12s; }
.cloth-item:nth-child(5) { animation-delay: 0.15s; }
.cloth-item:nth-child(6) { animation-delay: 0.18s; }
.cloth-item:nth-child(7) { animation-delay: 0.21s; }
.cloth-item:nth-child(8) { animation-delay: 0.24s; }

@keyframes fadeSlideUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.cloth-item--selected {
  border-color: #ff2442;
  background: #fff5f7;
}

.cloth-cover {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  border-radius: 10rpx;
  overflow: hidden;
}

.cloth-cover--oat { background: linear-gradient(180deg, #e5d7c3, #f6efe6); }
.cloth-cover--blue { background: linear-gradient(180deg, #bfd0e3, #edf4fb); }
.cloth-cover--cream { background: linear-gradient(180deg, #e6dccd, #fbf7ef); }
.cloth-cover--black { background: linear-gradient(180deg, #535252, #989592); }
.cloth-cover--green { background: linear-gradient(180deg, #bfd0c6, #f0f7f2); }
.cloth-cover--brown { background: linear-gradient(180deg, #c5936b, #f4e7dc); }
.cloth-cover--red { background: linear-gradient(180deg, #d4a0a0, #f5e6e6); }
.cloth-cover--pink { background: linear-gradient(180deg, #e0b8c4, #f8edf2); }
.cloth-cover--gray { background: linear-gradient(180deg, #b5b5b5, #e8e8e8); }
.cloth-cover--white { background: linear-gradient(180deg, #e8e8e8, #f8f8f8); }

.cloth-image { width: 100%; height: 100%; }

.cloth-icon {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(34,28,24,0.6);
}

.cloth-check {
  position: absolute;
  top: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ff2442;
  border-radius: 0 0 0 10rpx;
}

.cloth-check-icon {
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
}

.cloth-name {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #333333;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cloth-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #999999;
}

.form-field {
  margin-top: 24rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #555555;
  margin-bottom: 10rpx;
}

.field-input {
  width: 100%;
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.field-textarea {
  width: 100%;
  height: 140rpx;
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.scene-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.scene-tag {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  color: #666666;
  font-size: 24rpx;
}

.scene-tag--active {
  background: #ffe8ec;
  color: #ff2442;
  font-weight: 600;
}

.form-card {
  animation: slideUp 0.4s ease-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.save-btn {
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #ff2442;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.save-btn--pressed {
  transform: scale(0.98);
  opacity: 0.85;
}

.save-btn-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}
</style>

<script type="application/json">
  { "component": true }
</script>
