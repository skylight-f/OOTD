.selected-cover--brown { background: linear-gradient(180deg, #c5936b, #f4e7dc); }
.selected-cover--red { background: linear-gradient(180deg, #d4a0a0, #f5e6e6); }
.selected-cover--pink { background: linear-gradient(180deg, #e0b8c4, #f8edf2); }
.selected-cover--gray { background: linear-gradient(180deg, #b5b5b5, #e8e8e8); }
