  flex-shrink: 0;
}

.picker-cover--oat { background: linear-gradient(180deg, #e5d7c3, #f6efe6); }
.picker-cover--blue { background: linear-gradient(180deg, #bfd0e3, #edf4fb); }
.picker-cover--cream { background: linear-gradient(180deg, #e6dccd, #fbf7ef); }
.picker-cover--black { background: linear-gradient(180deg, #535252, #989592); }
.picker-cover--green { background: linear-gradient(180deg, #bfd0c6, #f0f7f2); }
.picker-cover--brown { background: linear-gradient(180deg, #c5936b, #f4e7dc); }
