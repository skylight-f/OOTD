  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.month-nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
}

.nav-arrow {
  font-size: 36rpx;
  color: #333333;
}

.month-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222222;
}

.week-header {
  display: flex;
  margin-top: 16rpx;
}

.week-day {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.calendar-cell {
  width: calc(100% / 7);
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
}

.calendar-cell--other {
  opacity: 0.3;
}

.calendar-cell--today {
  background: #ffe8ec;
  border-radius: 12rpx;
}

.calendar-cell--active {
  background: #fff5f7;
  border-radius: 12rpx;
}

.cell-day {
  font-size: 28rpx;
  color: #333333;
}

.calendar-cell--today .cell-day {
  color: #ff2442;
  font-weight: 700;
}

.cell-dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background: #ff2442;
}

.cell-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #ff2442;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cell-badge-text {
  font-size: 18rpx;
  color: #ffffff;
}

.section-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #222222;
}

.section-subtitle {
  font-size: 22rpx;
  color: #999999;
}

.empty-hint {
  margin-top: 24rpx;
  padding: 40rpx;
  text-align: center;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.empty-hint-text {
  font-size: 24rpx;
  color: #999999;
}

.record-list {
  margin-top: 20rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.record-cover--oat { background: linear-gradient(180deg, #e5d7c3, #f6efe6); }
.record-cover--blue { background: linear-gradient(180deg, #bfd0e3, #edf4fb); }
.record-cover--cream { background: linear-gradient(180deg, #e6dccd, #fbf7ef); }
.record-cover--black { background: linear-gradient(180deg, #535252, #989592); }
.record-cover--green { background: linear-gradient(180deg, #bfd0c6, #f0f7f2); }
.record-cover--brown { background: linear-gradient(180deg, #c5936b, #f4e7dc); }

.record-image {
  width: 100%;
  height: 100%;
}

.record-icon {
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(34, 28, 24, 0.6);
}

.record-info {
  flex: 1;
  margin-left: 20rpx;
}

.record-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
}

.record-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}

.month-stats {
  display: flex;
  margin-top: 20rpx;
  gap: 16rpx;
}

.month-stat {
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f8f8f8;
  text-align: center;
}

.month-stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #ff2442;
}

.month-stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}
</style>

<script type="application/json">
  {
    "component": true
  }
</script>
