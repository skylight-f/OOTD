  display: flex;
  margin-top: 28rpx;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  padding: 22rpx 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #f3e1ce 0%, #fbf6f1 100%);
}

.stat-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7b685b;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

