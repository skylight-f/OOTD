  background: rgba(255, 250, 245, 0.96);
  box-shadow: 0 16rpx 40rpx rgba(92, 63, 39, 0.08);
}

.search-icon {
  font-size: 24rpx;
  color: #a3a3a3;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #222222;
}

.search-clear {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  line-height: 34rpx;
  text-align: center;
  background: #f2f2f2;
  color: #7d7d7d;
  font-size: 18rpx;
}

.section-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d241c;
}

