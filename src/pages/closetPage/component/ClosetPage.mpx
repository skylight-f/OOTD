}

.wardrobe-card {
  padding-bottom: 12rpx;
}

.wardrobe-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.wardrobe-empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.wardrobe-empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #555555;
  margin-bottom: 12rpx;
}

.wardrobe-empty-desc {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
}

.wardrobe-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 22rpx;
}

.wardrobe-item {
  width: 48%;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #fffaf6;
  position: relative;
  animation: fadeSlideUp 0.4s ease-out backwards;
}

.wardrobe-item:nth-child(1) { animation-delay: 0.05s; }
.wardrobe-item:nth-child(2) { animation-delay: 0.1s; }
.wardrobe-item:nth-child(3) { animation-delay: 0.15s; }
.wardrobe-item:nth-child(4) { animation-delay: 0.2s; }
.wardrobe-item:nth-child(5) { animation-delay: 0.25s; }
.wardrobe-item:nth-child(6) { animation-delay: 0.3s; }

@keyframes fadeSlideUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.wardrobe-item-inner {
  position: relative;
  z-index: 2;
  background: #fffaf6;
  transition: transform 0.3s ease;
}

.wardrobe-item--swiped .wardrobe-item-inner {
  transform: translateX(-120rpx);
}

.item-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ff3b30;
  z-index: 1;
}

.item-delete-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
}

.item-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 180rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.item-image {
  width: 100%;
  height: 100%;
}

.item-cover--oat {
  background: linear-gradient(180deg, #e5d7c3 0%, #f6efe6 100%);
}

.item-cover--blue {
  background: linear-gradient(180deg, #bfd0e3 0%, #edf4fb 100%);
}

.item-cover--cream {
  background: linear-gradient(180deg, #e6dccd 0%, #fbf7ef 100%);
}

.item-cover--black {
  background: linear-gradient(180deg, #535252 0%, #989592 100%);
}

.item-cover--green {
  background: linear-gradient(180deg, #bfd0c6 0%, #f0f7f2 100%);
}

.item-cover--brown {
