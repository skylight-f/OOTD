  color: #2d241c;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a7768;
  text-align: center;
  line-height: 1.6;
}

.empty-btn {
  margin-top: 32rpx;
  padding: 20rpx 60rpx;
