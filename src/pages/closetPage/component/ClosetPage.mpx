}

.item-cover--red {
  background: linear-gradient(180deg, #d4a0a0 0%, #f5e6e6 100%);
}

.item-cover--pink {
  background: linear-gradient(180deg, #e0b8c4 0%, #f8edf2 100%);
}

.item-cover--gray {
  background: linear-gradient(180deg, #b5b5b5 0%, #e8e8e8 100%);
}

.item-cover--white {
  background: linear-gradient(180deg, #e8e8e8 0%, #f8f8f8 100%);
}

.item-icon {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: rgba(34, 28, 24, 0.72);
}

.item-name {
  display: block;
  margin-top: 16rpx;
  padding: 0 18rpx;
  font-size: 26rpx;
  color: #2d241c;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  display: block;
  margin-top: 8rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
  color: #7d6a5d;
}

.item-scene {
  display: block;
  margin-top: 8rpx;
  padding: 0 18rpx 18rpx;
  font-size: 22rpx;
  color: var(--color-primary);
}
</style>

<script type="application/json">
  {
    "component": true
  }
</script>
