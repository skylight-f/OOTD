<template>
  <view class="page closet-page">
    <view class="hero-card" bindtap="openDashboard" hover-class="hero-card--pressed">
      <view class="hero-head">
        <view>
          <text class="eyebrow">数字衣橱</text>
          <text class="hero-title">一眼找到能穿、好搭、适合今天的衣服</text>
        </view>
        <text class="hero-link">看板</text>
      </view>
      <view class="stats-row">
        <view wx:for="{{stats}}" wx:key="label" class="stat-card">
          <text class="stat-value">{{item.value}}</text>
          <text class="stat-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="action-row">
      <view class="action-card" bindtap="goAddClothes" hover-class="action-card--pressed">
        <text class="action-title">拍照录入</text>
        <text class="action-desc">上传新衣物，自动识别类别和颜色</text>
      </view>
      <view class="action-card" bindtap="onTapClassify" hover-class="action-card--pressed">
        <text class="action-title">智能整理</text>
        <text class="action-desc">按季节、场合和材质快速分类</text>
      </view>
    </view>

    <!-- 搜索栏 -->
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索衣物名称、颜色、材质"
        value="{{searchKey}}"
        bindinput="onSearchInput"
        confirm-type="search"
      />
      <text wx:if="{{searchKey}}" class="search-clear" bindtap="clearSearch">✕</text>
    </view>

    <!-- 筛选标签 -->
    <view class="section-card">
      <text class="section-title">筛选条件</text>
      <view class="chip-group">
        <text
          wx:for="{{filterOptions}}"
          wx:key="*this"
          class="chip {{activeFilter === item ? 'chip--active' : ''}}"
          data-filter="{{item}}"
          bindtap="onTapFilter"
        >{{item}}</text>
      </view>
    </view>

    <!-- 衣物列表 -->
    <view class="section-card wardrobe-card">
      <view class="section-head">
        <text class="section-title">{{activeFilter === '全部' ? '所有单品' : activeFilter}}</text>
        <text class="section-subtitle">{{displayItems.length}} 件单品</text>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{displayItems.length === 0}}" class="wardrobe-empty">
        <text class="wardrobe-empty-icon">👗</text>
        <text class="wardrobe-empty-title">{{searchKey || activeFilter !== '全部' ? '没有匹配的衣物' : '衣橱还是空的'}}</text>
        <text class="wardrobe-empty-desc">{{searchKey || activeFilter !== '全部' ? '试试切换筛选条件或清空关键词' : '去添加你的第一件衣物吧'}}</text>
      </view>

      <view wx:else class="wardrobe-grid">
        <view
          wx:for="{{displayItems}}"
          wx:key="id"
          class="wardrobe-item {{swipeId === item.id ? 'wardrobe-item--swiped' : ''}}"
          data-id="{{item.id}}"
          bindtap="goDetail"
          bindtouchstart="onSwipeStart"
          bindtouchend="onSwipeEnd"
        >
          <view class="wardrobe-item-inner">
            <view class="item-cover item-cover--{{item.tone}}">
              <image wx:if="{{item.imagePath}}" class="item-image" src="{{item.imagePath}}" mode="aspectFill" />
              <text wx:else class="item-icon">{{item.icon}}</text>
            </view>
            <text class="item-name">{{item.name}}</text>
            <text class="item-meta">{{item.color}} · {{item.material}}</text>
            <text class="item-scene">{{item.scene}}</text>
          </view>
          <view class="item-delete" data-id="{{item.id}}" catchtap="onDeleteItem">
            <text class="item-delete-text">删除</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script lang="ts">
import { createComponent } from '@mpxjs/core'
import {
  getAllClothes,
  deleteClothing,
  getClothingStats,
  CATEGORY_OPTIONS,
  type ClothingItem
} from '@/utils/storage'

interface DisplayItem {
  id: string
  name: string
  color: string
  material: string
  scene: string
  tone: string
  icon: string
  imagePath: string
}

function toDisplay(item: ClothingItem): DisplayItem {
  const iconMap: Record<string, string> = {
    '上装': 'TOP', '下装': 'BOTTOM', '外套': 'COAT',
    '鞋履': 'SHOE', '配饰': 'ACC', '包袋': 'BAG',
    '连衣裙': 'DRESS', '半裙': 'SKIRT'
  }
  return {
    id: item.id,
    name: item.name,
    color: item.color,
    material: item.material,
    scene: item.scene,
    tone: item.tone || 'oat',
    icon: iconMap[item.category] || 'ITEM',
    imagePath: item.imagePath
  }
}

createComponent({
  data: {
    allItems: [] as DisplayItem[],
    displayItems: [] as DisplayItem[],
    stats: [
      { label: '总单品', value: '0' },
      { label: '春夏可穿', value: '0' },
      { label: '一周常穿', value: '0' }
    ],
    filterOptions: ['全部', ...CATEGORY_OPTIONS],
    activeFilter: '全部',
    searchKey: '',
    swipeId: '',
    touchStartX: 0
  },

  attached() {
    this.refreshData()
  },

  pageLifetimes: {
    show() {
      this.refreshData()
    }
  },

  methods: {
    refreshData() {
      const clothes = getAllClothes()
      const statsData = getClothingStats()

      const items = clothes.map(toDisplay)

      this.setData({
        allItems: items,
        stats: [
          { label: '总单品', value: String(statsData.total) },
          { label: '春夏可穿', value: String(statsData.seasonCount) },
          { label: '一周常穿', value: String(statsData.weekWorn) }
        ]
      })
      this.applyFilters()
    },

    applyFilters() {
      const { allItems, activeFilter, searchKey } = this.data
      const key = searchKey.trim().toLowerCase()

      let filtered = allItems
      if (activeFilter !== '全部') {
        const categoryMap: Record<string, string> = {
          '上装': '上装', '下装': '下装', '外套': '外套',
          '鞋履': '鞋履', '配饰': '配饰', '包袋': '包袋',
          '连衣裙': '连衣裙', '半裙': '半裙'
        }
        const targetCategory = categoryMap[activeFilter] || activeFilter
        filtered = filtered.filter((item) => {
          const iconMap: Record<string, string> = {
            'TOP': '上装', 'BOTTOM': '下装', 'COAT': '外套',
            'SHOE': '鞋履', 'ACC': '配饰', 'BAG': '包袋',
            'DRESS': '连衣裙', 'SKIRT': '半裙'
          }
          const itemCategory = iconMap[item.icon] || ''
          return itemCategory === targetCategory
        })
      }

      if (key) {
        filtered = filtered.filter((item) =>
          item.name.toLowerCase().includes(key) ||
          item.color.toLowerCase().includes(key) ||
          item.material.toLowerCase().includes(key) ||
          item.scene.toLowerCase().includes(key)
        )
      }

      this.setData({ displayItems: filtered })
    },

    onSearchInput(e: { detail: { value: string } }) {
      this.setData({ searchKey: e.detail.value })
      this.applyFilters()
    },

    clearSearch() {
      this.setData({ searchKey: '' })
      this.applyFilters()
    },

    onTapFilter(e: { currentTarget: { dataset: { filter: string } } }) {
      this.setData({ activeFilter: e.currentTarget.dataset.filter })
      this.applyFilters()
    },

    openDashboard() {
      wx.navigateTo({ url: '/pages/closetDashboardPage/index' })
    },

    goAddClothes() {
      wx.navigateTo({ url: '/pages/addClothesPage/index' })
    },

    onTapClassify() {
      wx.showToast({ title: '智能整理功能开发中', icon: 'none', duration: 1500 })
    },

    goDetail(e: { currentTarget: { dataset: { id: string } } }) {
      if (this.data.swipeId === e.currentTarget.dataset.id) {
        this.setData({ swipeId: '' })
        return
      }
      wx.navigateTo({ url: `/pages/clothingDetailPage/index?id=${e.currentTarget.dataset.id}` })
    },

    onSwipeStart(e: { touches: Array<{ clientX: number }> }) {
      this.setData({ touchStartX: e.touches[0].clientX })
    },

    onSwipeEnd(e: { changedTouches: Array<{ clientX: number }>; currentTarget: { dataset: { id: string } } }) {
      const deltaX = e.changedTouches[0].clientX - this.data.touchStartX
      if (deltaX < -50) {
        this.setData({ swipeId: e.currentTarget.dataset.id })
      } else if (deltaX > 30) {
        this.setData({ swipeId: '' })
      }
    },

    onDeleteItem(e: { currentTarget: { dataset: { id: string } } }) {
      const id = e.currentTarget.dataset.id
      const item = this.data.allItems.find((i) => i.id === id)
      wx.showModal({
        title: '确认删除',
        content: `确定要删除「${item?.name || '该衣物'}」吗？删除后无法恢复。`,
        confirmText: '删除',
        confirmColor: '#ff2442',
        success: (res) => {
          if (res.confirm) {
            deleteClothing(id)
            this.refreshData()
            wx.showToast({ title: '已删除', icon: 'success' })
          }
          this.setData({ swipeId: '' })
        }
      })
    }
  }
})
</script>

<style lang="less">
