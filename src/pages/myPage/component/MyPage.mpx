  font-size: 24rpx;
  font-weight: 500;
}

.sync-btn:active {
  opacity: 0.8;
}

.sync-btn--save {
  background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  color: #f8f4ee;
}

.sync-btn--test {
  background: rgba(125, 106, 92, 0.12);
  color: #4a3f36;
}

