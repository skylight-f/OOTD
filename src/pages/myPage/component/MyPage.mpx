<template>
  <view class="page profile-page">
    <view class="profile-card">
      <view class="profile-top">
        <view class="avatar">SKY</view>
        <view class="profile-info">
          <text class="profile-name">Skylight</text>
          <text class="profile-bio">极简通勤风 · 喜欢低饱和配色和轻层次叠穿</text>
        </view>
      </view>

      <view class="profile-stats">
        <view wx:for="{{stats}}" wx:key="label" class="profile-stat">
          <text class="profile-stat__value">{{item.value}}</text>
          <text class="profile-stat__label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="section-card highlight-card">
      <text class="section-title">本周风格画像</text>
      <text class="highlight-title">轻通勤 · 柔和色调 · 低复杂度搭配</text>
      <view class="chip-group">
        <text wx:for="{{styleTags}}" wx:key="*this" class="chip chip--accent">{{item}}</text>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">快捷入口</text>
      <view class="menu-list">
        <view wx:for="{{menus}}" wx:key="title" class="menu-item">
          <view>
            <text class="menu-title">{{item.title}}</text>
            <text class="menu-desc">{{item.desc}}</text>
          </view>
          <text class="menu-arrow">></text>
        </view>
      </view>
    </view>
  </view>
</template>

<script lang="ts">
import { createComponent } from '@mpxjs/core'
import { getClothingStats, getAllOutfits, getAllClothes } from '@/utils/storage'

/** 计算连续打卡天数 */
function calcStreak(clothes: ReturnType<typeof getAllClothes>): number {
  const now = Date.now()
  const dayMs = 24 * 60 * 60 * 1000
  const today = new Date()
  today.setHours(0, 0, 0, 0)
  const todayStart = today.getTime()

  // 收集所有穿着日期（去重）
  const wornDates = new Set<number>()
  clothes.forEach((c) => {
    if (c.lastWornAt > 0) {
      const d = new Date(c.lastWornAt)
      d.setHours(0, 0, 0, 0)
      wornDates.add(d.getTime())
    }
  })

  // 从今天往前数连续天数
  let streak = 0
  let checkDate = todayStart
  while (wornDates.has(checkDate)) {
    streak++
    checkDate -= dayMs
  }
  return streak
}

/** 分析风格标签 */
function buildStyleTags(clothes: ReturnType<typeof getAllClothes>): string[] {
  const tags: string[] = []
  const colors = new Set<string>()
  const categories = new Set<string>()
  const scenes = new Set<string>()

  clothes.forEach((c) => {
    if (c.color) colors.add(c.color)
    categories.add(c.category)
    c.scene.split(' / ').map((s) => s.trim()).forEach((s) => scenes.add(s))
  })

  // 根据实际数据生成标签
  const colorStr = Array.from(colors).join('、')
  if (colorStr) tags.push(colorStr)
  if (scenes.has('通勤')) tags.push('通勤风格')
  if (scenes.has('周末') || scenes.has('休闲')) tags.push('周末休闲')
  if (clothes.length >= 20) tags.push('衣橱丰盈')
  if (clothes.length >= 5) tags.push('基础款搭配')

  return tags.length > 0 ? tags.slice(0, 5) : ['基础款穿搭', '简约风格']
}

createComponent({
  data: {
    stats: [
      { label: '搭配保存', value: '0' },
      { label: '总穿搭次数', value: '0' },
      { label: '连续打卡', value: '0' }
    ],
    styleTags: ['加载中...'] as string[],
    menus: [
      { title: '衣橱管理', desc: '分类整理、批量编辑、清理闲置单品' },
      { title: '天气提醒', desc: '降温、下雨、换季时收到穿搭建议' },
      { title: '账号设置', desc: '同步数据、隐私偏好和小程序设置' }
    ]
  },

  attached() {
    this.refreshData()
  },

  methods: {
    refreshData() {
      const statsData = getClothingStats()
      const outfits = getAllOutfits()
      const clothes = getAllClothes()

      // 总穿搭次数 = 所有衣物的 wearCount 之和
      const totalWears = clothes.reduce((sum, c) => sum + c.wearCount, 0)

      const streak = calcStreak(clothes)
      const tags = buildStyleTags(clothes)

      this.setData({
        stats: [
          { label: '搭配保存', value: String(outfits.length) },
          { label: '总穿搭次数', value: String(totalWears) },
          { label: '连续打卡', value: `${streak} 天` }
        ],
        styleTags: tags
      })
    }
  }
})
</script>

