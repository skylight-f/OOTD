<template>
  <view class="page profile-page">
    <view class="profile-card">
      <view class="profile-top">
        <view class="avatar">SKY</view>
        <view class="profile-info">
          <text class="profile-name">Skylight</text>
          <text class="profile-bio">极简通勤风 · 喜欢低饱和配色和轻层次叠穿</text>
        </view>
      </view>

      <view class="profile-stats">
        <view wx:for="{{stats}}" wx:key="label" class="profile-stat">
          <text class="profile-stat__value">{{item.value}}</text>
          <text class="profile-stat__label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="section-card highlight-card">
      <text class="section-title">本周风格画像</text>
      <text class="highlight-title">{{styleTitle}}</text>
      <view class="chip-group">
        <text wx:for="{{styleTags}}" wx:key="*this" class="chip chip--accent">{{item}}</text>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">快捷入口</text>
      <view class="menu-list">
        <view wx:for="{{menus}}" wx:key="title" class="menu-item" data-index="{{index}}" bindtap="onTapMenu">
          <view>
            <text class="menu-title">{{item.title}}</text>
            <text class="menu-desc">{{item.desc}}</text>
          </view>
          <text class="menu-arrow">></text>
        </view>
      </view>
    </view>

    <view class="section-card" wx:if="{{showSyncPanel}}">
      <view class="sync-header">
        <text class="section-title">云同步设置</text>
        <text class="sync-close" bindtap="onCloseSync">关闭</text>
      </view>

      <view class="sync-form">
        <view class="form-item">
          <text class="form-label">服务器地址</text>
          <input
            class="form-input"
            placeholder="https://dav.jianguoyun.com/dav/"
            value="{{syncConfig.url}}"
            data-field="url"
            bindinput="onSyncInput"
          />
        </view>
        <view class="form-item">
          <text class="form-label">用户名</text>
          <input
            class="form-input"
            placeholder="邮箱或应用账号"
            value="{{syncConfig.username}}"
            data-field="username"
            bindinput="onSyncInput"
          />
        </view>
        <view class="form-item">
          <text class="form-label">应用密码</text>
          <input
            class="form-input"
            placeholder="非主密码，请使用应用密码"
            password="{{true}}"
            value="{{syncConfig.password}}"
            data-field="password"
            bindinput="onSyncInput"
          />
        </view>
      </view>

      <view class="sync-actions">
        <view class="sync-btn sync-btn--save" bindtap="onSaveSyncConfig">
          <text>保存配置</text>
        </view>
        <view class="sync-btn sync-btn--test" bindtap="onTestSync">
          <text>测试连接</text>
        </view>
      </view>

      <view class="sync-divider"></view>

      <view class="sync-actions">
        <view class="sync-btn sync-btn--upload" bindtap="onUploadSync">
          <text>上传到云端</text>
        </view>
        <view class="sync-btn sync-btn--download" bindtap="onDownloadSync">
          <text>从云端下载</text>
        </view>
      </view>

      <view class="sync-actions">
        <view class="sync-btn sync-btn--auto" bindtap="onAutoSync">
          <text>自动同步</text>
        </view>
      </view>

      <text class="sync-hint">首次使用请先在坚果云根目录创建 ootd 文件夹</text>
      <text class="sync-status" wx:if="{{syncStatus}}">{{syncStatus}}</text>
    </view>
  </view>
</template>

<script lang="ts">
import { createComponent } from '@mpxjs/core'
import { getClothingStats, getAllOutfits, getAllClothes, exportAllData, importData, getLocalTime } from '@/utils/storage'
import {
  getConfig as getSyncConfig,
  saveConfig as saveSyncConfig,
  testConnection,
  uploadToCloud,
  downloadFromCloud,
  autoSync,
  type WebdavConfig
} from '@/utils/sync'

/** 计算连续打卡天数 */
function calcStreak(clothes: ReturnType<typeof getAllClothes>): number {
  const now = Date.now()
  const dayMs = 24 * 60 * 60 * 1000
  const today = new Date()
  today.setHours(0, 0, 0, 0)
  const todayStart = today.getTime()

  // 收集所有穿着日期（去重）
  const wornDates = new Set<number>()
  clothes.forEach((c) => {
    if (c.lastWornAt > 0) {
      const d = new Date(c.lastWornAt)
      d.setHours(0, 0, 0, 0)
      wornDates.add(d.getTime())
    }
  })

  // 从今天往前数连续天数
  let streak = 0
  let checkDate = todayStart
  while (wornDates.has(checkDate)) {
    streak++
    checkDate -= dayMs
  }
  return streak
}

/** 分析风格标签和标题 */
function buildStyleProfile(clothes: ReturnType<typeof getAllClothes>): { title: string; tags: string[] } {
  const tags: string[] = []
  const colors = new Set<string>()
  const categories = new Set<string>()
  const scenes = new Set<string>()

  clothes.forEach((c) => {
    if (c.color) colors.add(c.color)
    categories.add(c.category)
    c.scene.split(' / ').map((s) => s.trim()).forEach((s) => scenes.add(s))
  })

  const colorStr = Array.from(colors).join('、')
  if (colorStr) tags.push(colorStr)
  if (scenes.has('通勤')) tags.push('通勤风格')
  if (scenes.has('周末') || scenes.has('休闲')) tags.push('周末休闲')
  if (clothes.length >= 20) tags.push('衣橱丰盈')
  if (clothes.length >= 5) tags.push('基础款搭配')

  const finalTags = tags.length > 0 ? tags.slice(0, 5) : ['基础款穿搭', '简约风格']

  // 生成风格标题
  const parts: string[] = []
  if (scenes.has('通勤')) parts.push('轻通勤')
  if (scenes.has('周末') || scenes.has('休闲')) parts.push('休闲')
  if (scenes.has('约会')) parts.push('约会')

  const dominantColors = Array.from(colors).slice(0, 2)
  if (dominantColors.length > 0) {
    parts.push(dominantColors.join('色调'))
  }

  if (categories.size <= 3) {
    parts.push('低复杂度搭配')
  } else if (categories.size >= 5) {
    parts.push('多品类混搭')
  }

  const title = parts.length > 0 ? parts.join(' · ') : '简约风格 · 基础搭配'

  return { title, tags: finalTags }
}

createComponent({
  data: {
    stats: [
      { label: '搭配保存', value: '0' },
      { label: '总穿搭次数', value: '0' },
      { label: '收藏衣物', value: '0' },
      { label: '连续打卡', value: '0' }
    ],
    styleTitle: '加载中...' as string,
    styleTags: ['加载中...'] as string[],
    menus: [
      { title: '穿搭日历', desc: '查看每日穿搭记录和月度统计' },
      { title: '衣橱管理', desc: '分类整理、批量编辑、清理闲置单品' },
      { title: '数据管理', desc: '导出备份、导入恢复衣物和搭配数据' },
      { title: '云同步', desc: '通过 WebDAV 网盘同步数据到云端' }
    ],
    showSyncPanel: false,
    syncConfig: {
      url: '',
      username: '',
      password: ''
    } as WebdavConfig,
    syncStatus: '' as string
  },

  attached() {
    this.loadSyncConfig()
    this.refreshData()
  },

  pageLifetimes: {
    show() {
      this.refreshData()
    }
  },

  methods: {
    loadSyncConfig() {
      const config = getSyncConfig()
      if (config) {
        this.setData({
          syncConfig: {
            url: config.url,
            username: config.username,
            password: config.password
          }
        })
      }
    },

    onTapMenu(e: { currentTarget: { dataset: { index: number } } }) {
      const index = Number(e.currentTarget.dataset.index)

      if (index === 0) {
        wx.navigateTo({ url: '/pages/calendarPage/index' })
        return
      }

      if (index === 1) {
        wx.switchTab({ url: '/pages/closetPage/index' })
        return
      }

      if (index === 2) {
        this.onTapDataManage()
        return
      }

      if (index === 3) {
        this.setData({ showSyncPanel: !this.data.showSyncPanel, syncStatus: '' })
        return
      }
    },

    /** 数据管理：导出/导入 */
    onTapDataManage() {
      wx.showActionSheet({
        itemList: ['导出数据到剪贴板', '从剪贴板导入数据'],
        success: (res) => {
          if (res.tapIndex === 0) {
            this.exportData()
          } else if (res.tapIndex === 1) {
            this.importData()
          }
        }
      })
    },

    /** 导出数据 */
    exportData() {
      const data = exportAllData()
      wx.setClipboardData({
        data,
        success: () => {
          wx.showToast({ title: '已复制到剪贴板', icon: 'success' })
        }
      })
    },

    /** 导入数据 */
    importData() {
      wx.getClipboardData({
        success: (res) => {
          const data = res.data
          if (!data) {
            wx.showToast({ title: '剪贴板为空', icon: 'none' })
            return
          }
          wx.showModal({
            title: '导入数据',
            content: '导入会合并现有数据，重复的衣物将被跳过。确定继续？',
            success: (modalRes) => {
              if (modalRes.confirm) {
                const result = importData(data, 'merge')
                if (result.success) {
                  this.refreshData()
                  wx.showToast({ title: '导入成功', icon: 'success' })
                } else {
                  wx.showToast({ title: result.message, icon: 'none' })
                }
              }
            }
          })
        }
      })
    },

    /** WebDAV 表单输入 */
    onSyncInput(e: { detail: { value: string }; currentTarget: { dataset: { field: string } } }) {
      const field = e.currentTarget.dataset.field
      const value = e.detail.value
      this.setData({
        [`syncConfig.${field}`]: value
      })
    },

    /** 保存配置 */
    onSaveSyncConfig() {
      const { url, username, password } = this.data.syncConfig
      if (!url || !username || !password) {
        wx.showToast({ title: '请填写完整配置', icon: 'none' })
        return
      }
      saveSyncConfig({ url, username, password })
      wx.showToast({ title: '配置已保存', icon: 'success' })
    },

    /** 测试连接 */
    async onTestSync() {
      const { url, username, password } = this.data.syncConfig
      if (!url || !username || !password) {
        wx.showToast({ title: '请先填写配置', icon: 'none' })
        return
      }
      this.setData({ syncStatus: '正在测试连接...' })
      const result = await testConnection({ url, username, password })
      this.setData({ syncStatus: result.message })
    },

    /** 上传到云端 */
    async onUploadSync() {
      this.setData({ syncStatus: '正在上传...' })
      const result = await uploadToCloud()
      this.setData({ syncStatus: result.message })
      if (result.success) {
        wx.showToast({ title: '上传成功', icon: 'success' })
      }
    },

    /** 从云端下载 */
    async onDownloadSync() {
      this.setData({ syncStatus: '正在下载...' })
      const result = await downloadFromCloud()
      this.setData({ syncStatus: result.message })
      if (result.success) {
        this.refreshData()
        wx.showToast({ title: '下载成功', icon: 'success' })
      }
    },

    /** 自动同步 */
    async onAutoSync() {
      this.setData({ syncStatus: '正在同步...' })
      const result = await autoSync()
      this.setData({ syncStatus: result.message })
      if (result.success) {
        this.refreshData()
        wx.showToast({ title: '同步完成', icon: 'success' })
      }
    },

    /** 关闭同步面板 */
    onCloseSync() {
      this.setData({ showSyncPanel: false, syncStatus: '' })
    },

    refreshData() {
      const statsData = getClothingStats()
      const outfits = getAllOutfits()
      const clothes = getAllClothes()

      // 总穿搭次数 = 所有衣物的 wearCount 之和
      const totalWears = clothes.reduce((sum, c) => sum + c.wearCount, 0)

      // 收藏数量 = favorite 为 true 的衣物数量
      const favoriteCount = clothes.filter((c) => c.favorite).length

      const streak = calcStreak(clothes)
      const profile = buildStyleProfile(clothes)

      this.setData({
        stats: [
          { label: '搭配保存', value: String(outfits.length) },
          { label: '总穿搭次数', value: String(totalWears) },
          { label: '收藏衣物', value: String(favoriteCount) },
          { label: '连续打卡', value: `${streak} 天` }
        ],
        styleTitle: profile.title,
        styleTags: profile.tags
      })
    }
  }
})
</script>

<style lang="less">
