<template>
  <ClothingDetailPage clothingId="{{clothingId}}" />
</template>

<script lang="ts">
import { createPage } from '@mpxjs/core'
createPage({
  data: {
    clothingId: ''
  },
  onLoad(options: { id?: string }) {
    this.setData({ clothingId: options.id || '' })
  }
})
</script>

<script type="application/json">
  {
    "navigationBarTitleText": "衣物详情",
    "usingComponents": {
      "ClothingDetailPage": "./component/ClothingDetailPage"
    }
  }
</script>
