<template>
  <view class="page detail-page">
    <!-- 图片区 -->
    <view class="image-section">
      <image
        wx:if="{{clothing.imagePath}}"
        class="cover-image"
        src="{{clothing.imagePath}}"
        mode="aspectFill"
      />
      <view wx:else class="cover-placeholder cover-placeholder--{{clothing.tone}}">
        <text class="cover-icon">{{clothing.icon}}</text>
        <text class="cover-label">暂无图片</text>
      </view>
    </view>

    <!-- 查看模式 -->
    <view wx:if="{{!editing}}" class="info-card">
      <view class="info-head">
        <view>
          <text class="info-name">{{clothing.name}}</text>
          <text class="info-category">{{clothing.category}}</text>
        </view>
        <view class="info-tone-dot info-tone-dot--{{clothing.tone}}"></view>
      </view>

      <!-- 核心信息 -->
      <view class="info-grid">
        <view class="info-item">
          <text class="info-label">颜色</text>
          <text class="info-value">{{clothing.color}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">材质</text>
          <text class="info-value">{{clothing.material}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">季节</text>
          <text class="info-value">{{clothing.season}}</text>
        </view>
        <view class="info-item" wx:if="{{clothing.brand}}">
          <text class="info-label">品牌</text>
          <text class="info-value">{{clothing.brand}}</text>
        </view>
      </view>

      <!-- 适合场景 -->
      <view class="info-section">
        <text class="info-label">适合场景</text>
        <view class="scene-row">
          <text wx:for="{{sceneList}}" wx:key="*this" class="scene-badge">{{item}}</text>
        </view>
      </view>

      <!-- 穿着统计 -->
      <view class="info-section">
        <text class="info-label">穿着统计</text>
        <view class="stats-row">
          <view class="detail-stat">
            <text class="detail-stat-value">{{clothing.wearCount}}</text>
            <text class="detail-stat-label">穿着次数</text>
          </view>
          <view class="detail-stat">
            <text class="detail-stat-value">{{lastWornText}}</text>
            <text class="detail-stat-label">最后一次穿着</text>
          </view>
          <view class="detail-stat">
            <text class="detail-stat-value">{{createdText}}</text>
            <text class="detail-stat-label">录入时间</text>
          </view>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="action-bar">
        <view class="action-btn action-btn--wear" bindtap="handleWear" hover-class="action-btn--pressed">
          <text class="action-btn-text">记录穿着</text>
        </view>
        <view class="action-btn action-btn--edit" bindtap="enterEdit" hover-class="action-btn--pressed">
          <text class="action-btn-text">编辑</text>
        </view>
        <view class="action-btn action-btn--delete" bindtap="showDeleteConfirm" hover-class="action-btn--pressed">
          <text class="action-btn-text">删除</text>
        </view>
      </view>
    </view>

    <!-- 编辑模式 -->
    <view wx:else class="info-card edit-card">
      <text class="edit-title">编辑衣物信息</text>

      <!-- 名称 -->
      <view class="form-field">
        <text class="field-label">名称</text>
        <input class="field-input" value="{{editForm.name}}" data-field="name" bindinput="handleEditInput" />
      </view>

      <!-- 类别 -->
      <view class="form-field">
        <text class="field-label">类别</text>
        <picker mode="selector" range="{{categoryOptions}}" value="{{editCategoryIndex}}" bindchange="handleEditCategory">
          <view class="field-picker">
            <text class="picker-text">{{categoryOptions[editCategoryIndex]}}</text>
            <text class="picker-arrow">▸</text>
          </view>
        </picker>
      </view>

      <!-- 颜色 -->
      <view class="form-field">
        <text class="field-label">颜色</text>
        <input class="field-input" value="{{editForm.color}}" data-field="color" bindinput="handleEditInput" />
      </view>

      <!-- 材质 -->
      <view class="form-field">
        <text class="field-label">材质</text>
        <input class="field-input" value="{{editForm.material}}" data-field="material" bindinput="handleEditInput" />
      </view>

      <!-- 季节 -->
      <view class="form-field">
        <text class="field-label">季节</text>
        <picker mode="selector" range="{{seasonOptions}}" value="{{editSeasonIndex}}" bindchange="handleEditSeason">
          <view class="field-picker">
            <text class="picker-text">{{seasonOptions[editSeasonIndex]}}</text>
            <text class="picker-arrow">▸</text>
          </view>
        </picker>
      </view>

      <!-- 场景 -->
      <view class="form-field">
        <text class="field-label">适合场景</text>
        <view class="scene-tags">
          <text
            wx:for="{{sceneOptions}}"
            wx:key="*this"
            class="scene-tag {{editSelectedScenes[item] ? 'scene-tag--active' : ''}}"
            data-scene="{{item}}"
            bindtap="toggleEditScene"
          >{{item}}</text>
        </view>
      </view>

      <!-- 品牌 -->
      <view class="form-field">
        <text class="field-label">品牌</text>
        <input class="field-input" value="{{editForm.brand}}" data-field="brand" bindinput="handleEditInput" placeholder="可选" />
      </view>

      <!-- 编辑模式按钮 -->
      <view class="edit-actions">
        <view class="edit-btn edit-btn--cancel" bindtap="cancelEdit" hover-class="edit-btn--pressed">
          <text class="edit-btn-text">取消</text>
        </view>
        <view class="edit-btn edit-btn--save" bindtap="saveEdit" hover-class="edit-btn--pressed">
          <text class="edit-btn-text">保存</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script lang="ts">
import { createComponent } from '@mpxjs/core'
import {
  getClothingById,
  updateClothing,
  deleteClothing,
  recordWear,
  inferTone,
  categoryToIcon,
  CATEGORY_OPTIONS,
  SEASON_OPTIONS,
  SCENE_OPTIONS,
  type ClothingItem
} from '@/utils/storage'

function parseScenes(sceneText: string): string[] {
  if (!sceneText) return []
  return sceneText.split(' / ').filter(Boolean)
}

function buildSceneMap(scenes: string[]): Record<string, boolean> {
  const map: Record<string, boolean> = {}
  scenes.forEach((s) => { map[s] = true })
  return map
}

function formatDate(timestamp: number): string {
  if (!timestamp) return '暂无记录'
  const d = new Date(timestamp)
  const month = d.getMonth() + 1
  const day = d.getDate()
  return `${month}月${day}日`
}

createComponent({
  data: {
    clothing: null as ClothingItem | null,
    editing: false,
    categoryOptions: CATEGORY_OPTIONS,
    seasonOptions: SEASON_OPTIONS,
    sceneOptions: SCENE_OPTIONS,
    sceneList: [] as string[],
    lastWornText: '暂无记录',
    createdText: '',
    editCategoryIndex: 0,
    editSeasonIndex: 0,
    editSelectedScenes: {} as Record<string, boolean>,
    editForm: {
      name: '',
      color: '',
      material: '',
      brand: ''
    }
  },

  attached() {
    const pages = getCurrentPages()
    const options = pages[pages.length - 1].options
    const id = options.id
    if (!id) {
      wx.showToast({ title: '衣物不存在', icon: 'none' })
      setTimeout(() => wx.navigateBack(), 1200)
      return
    }

    const item = getClothingById(id)
    if (!item) {
      wx.showToast({ title: '衣物不存在', icon: 'none' })
      setTimeout(() => wx.navigateBack(), 1200)
      return
    }

    const scenes = parseScenes(item.scene)

    this.setData({
      clothing: {
        ...item,
        icon: categoryToIcon(item.category),
        tone: item.tone || inferTone(item.color)
      },
      sceneList: scenes,
      lastWornText: formatDate(item.lastWornAt),
      createdText: formatDate(item.createdAt)
    })
  },

  methods: {
    /** 记录穿着 */
    handleWear() {
      const item = this.data.clothing
      if (!item) return

      recordWear(item.id)
      const updated = getClothingById(item.id)
      if (updated) {
        this.setData({
          clothing: {
            ...updated,
            icon: categoryToIcon(updated.category),
            tone: updated.tone || inferTone(updated.color)
          },
          lastWornText: formatDate(updated.lastWornAt)
        })
        wx.showToast({ title: '已记录穿着', icon: 'success' })
      }
    },

    /** 进入编辑 */
    enterEdit() {
      const item = this.data.clothing
      if (!item) return

      const scenes = parseScenes(item.scene)

      this.setData({
        editing: true,
        editForm: {
          name: item.name,
          color: item.color,
          material: item.material,
          brand: item.brand || ''
        },
        editCategoryIndex: CATEGORY_OPTIONS.indexOf(item.category),
        editSeasonIndex: SEASON_OPTIONS.indexOf(item.season),
        editSelectedScenes: buildSceneMap(scenes)
      })
    },

    /** 取消编辑 */
    cancelEdit() {
      this.setData({ editing: false })
    },

    /** 保存编辑 */
    saveEdit() {
      const item = this.data.clothing
      if (!item) return

      const { editForm, editCategoryIndex, editSeasonIndex, editSelectedScenes, categoryOptions, seasonOptions } = this.data

      if (!editForm.name.trim()) {
        wx.showToast({ title: '请输入名称', icon: 'none' })
        return
      }

      const scenes = Object.keys(editSelectedScenes).filter((s) => editSelectedScenes[s])
      const sceneText = scenes.length > 0 ? scenes.join(' / ') : '日常'

      updateClothing(item.id, {
        name: editForm.name.trim(),
        category: categoryOptions[editCategoryIndex],
        color: editForm.color.trim() || '未标注',
        material: editForm.material.trim() || '未标注',
        scene: sceneText,
        season: seasonOptions[editSeasonIndex],
        brand: editForm.brand.trim(),
        tone: inferTone(editForm.color)
      })

      // 刷新数据
      const updated = getClothingById(item.id)
      if (updated) {
        const newScenes = parseScenes(updated.scene)
        this.setData({
          editing: false,
          clothing: {
            ...updated,
            icon: categoryToIcon(updated.category),
            tone: updated.tone || inferTone(updated.color)
          },
          sceneList: newScenes,  // 注意：这里用的是 newScenes 而不是 scenes
          lastWornText: formatDate(updated.lastWornAt),
          createdText: formatDate(updated.createdAt)
        })
        wx.showToast({ title: '已保存', icon: 'success' })
      }
    },

    handleEditInput(event: { detail: { value: string }; currentTarget: { dataset: { field: string } } }) {
      const field = event.currentTarget.dataset.field
      this.setData({
        [`editForm.${field}`]: event.detail.value
      })
    },

    handleEditCategory(event: { detail: { value: string } }) {
      this.setData({
        editCategoryIndex: Number(event.detail.value)
      })
    },

    handleEditSeason(event: { detail: { value: string } }) {
      this.setData({
        editSeasonIndex: Number(event.detail.value)
      })
    },

    toggleEditScene(event: { currentTarget: { dataset: { scene: string } } }) {
      const scene = event.currentTarget.dataset.scene
      const current = this.data.editSelectedScenes[scene]
      this.setData({
        [`editSelectedScenes.${scene}`]: !current
      })
    },

    /** 删除确认 */
    showDeleteConfirm() {
      const clothing = this.data.clothing
      if (!clothing) return
      wx.showModal({
        title: '确认删除',
        content: `确定要删除「${clothing.name}」吗？删除后无法恢复。`,
        confirmText: '删除',
        cancelText: '取消',
        confirmColor: '#ff2442',
        success: (res: any) => {
          if (res.confirm) {
            this.confirmDelete()
          }
        }
      })
    },

    /** 执行删除 */
    confirmDelete() {
      const item = this.data.clothing
      if (!item) return

      deleteClothing(item.id)
      wx.showToast({ title: '已删除', icon: 'success' })
      setTimeout(() => wx.navigateBack(), 800)
    }
  }
})
</script>

