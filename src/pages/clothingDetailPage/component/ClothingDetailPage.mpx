.cover-placeholder--blue { background: linear-gradient(180deg, #bfd0e3, #edf4fb); }
.cover-placeholder--cream { background: linear-gradient(180deg, #e6dccd, #fbf7ef); }
.cover-placeholder--black { background: linear-gradient(180deg, #535252, #989592); }
.cover-placeholder--green { background: linear-gradient(180deg, #bfd0c6, #f0f7f2); }
.cover-placeholder--brown { background: linear-gradient(180deg, #c5936b, #f4e7dc); }
.cover-placeholder--red { background: linear-gradient(180deg, #d4a0a0, #f5e6e6); }
.cover-placeholder--pink { background: linear-gradient(180deg, #e0b8c4, #f8edf2); }
